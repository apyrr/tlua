type LuaReadFormat = "*n" | "*a" | "*l" | number;

// File handles are userdata in Lua, so `type(file)` reports "userdata". Their
// methods live on the handle's metatable and take the handle as their first
// argument, so each declares `self`: `f:read("*a")` passes the receiver
// implicitly, `f.read(f, "*a")` writes it out.
interface LuaFile extends LuaUserdata {
    close(self: LuaFile): (boolean | nil, string?);
    flush(self: LuaFile): (boolean | nil, string?);
    lines(self: LuaFile, ...: LuaReadFormat): function;
    read(self: LuaFile, ...: LuaReadFormat): (any, ...any);
    seek(self: LuaFile, whence?: "set" | "cur" | "end", offset?: number): (number | nil, string?);
    setvbuf(self: LuaFile, mode: "no" | "full" | "line", size?: number): (boolean | nil, string?);
    write(self: LuaFile, ...: string | number): (LuaFile | nil, string?);
}

interface IOLib {
    readonly stdin: LuaFile;
    readonly stdout: LuaFile;
    readonly stderr: LuaFile;
    close(file?: LuaFile): (boolean | nil, string?);
    flush(): (boolean | nil, string?);
    input(file?: string | LuaFile): LuaFile;
    lines(filename?: string, ...: LuaReadFormat): function;
    open(filename: string, mode?: string): (LuaFile?, string?);
    output(file?: string | LuaFile): LuaFile;
    popen(command: string, mode?: "r" | "w"): (LuaFile?, string?);
    read(...: LuaReadFormat): (any, ...any);
    tmpfile(): LuaFile | nil;
    type(value: any): "file" | "closed file" | nil;
    write(...: string | number): (LuaFile | nil, string?);
}

declare io: IOLib;
