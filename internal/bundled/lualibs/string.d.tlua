// The string metatable's `__index` is the `string` table itself, so a string's
// members ARE StringLib's functions -- reached through a receiver rather than
// bound to one. Each therefore declares `self` explicitly, exactly as a colon
// method declaration does: `s:sub(1, 2)` passes the receiver as the implicit
// first argument, and the equivalent `s.sub(s, 1, 2)` writes it out.
interface String {
    readonly length: number;
    byte(self: string, i?: number, j?: number): (number?, ...number);
    find(self: string, pattern: string, init?: number, plain?: boolean): (number?, number?, ...string);
    format(self: string, ...: any): string;
    gmatch(self: string, pattern: string): () => string;
    gsub(self: string, pattern: string, replacement: string | table | function, n?: number): (string, number);
    len(self: string): number;
    lower(self: string): string;
    match(self: string, pattern: string, init?: number): (string?, ...string);
    rep(self: string, n: number): string;
    reverse(self: string): string;
    sub(self: string, i: number, j?: number): string;
    upper(self: string): string;
}

interface StringLib {
    byte(value: string, i?: number, j?: number): (number?, ...number);
    char(...: number): string;
    dump(fn: function): string;
    find(value: string, pattern: string, init?: number, plain?: boolean): (number?, number?, ...string);
    format(format: string, ...: any): string;
    gmatch(value: string, pattern: string): () => string;
    gsub(value: string, pattern: string, replacement: string | table | function, n?: number): (string, number);
    len(value: string): number;
    lower(value: string): string;
    match(value: string, pattern: string, init?: number): (string?, ...string);
    rep(value: string, n: number): string;
    reverse(value: string): string;
    sub(value: string, i: number, j?: number): string;
    upper(value: string): string;
}

declare string: StringLib;
