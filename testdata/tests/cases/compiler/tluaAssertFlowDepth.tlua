// @strict: true
// @noEmit: true
// @noTypesAndSymbols: true

// Statement asserts narrow in one pass over the flow graph, not one recursion
// each, so a function body with thousands of narrowing asserts keeps flow
// analysis (no TLUA2563) and still narrows across all of them.

declare function tick(): number
declare function parse(): (number, nil) | (nil, string)

function many(x: string | nil, y: number | nil): number
