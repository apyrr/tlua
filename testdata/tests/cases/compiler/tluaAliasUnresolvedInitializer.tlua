// @strict: true
// @noEmit: true
function unresolvedBehindAs(): void
  local b = notDeclaredAnywhere as { x: string | nil }
  local c = b
  assert(c.x)
  local _: string = b.x
end

function unresolvedBehindAnnotation(): void
  local b: { x: string | nil } = alsoNotDeclared
  local c = b
  assert(c.x)
  local _: string = b.x
end
