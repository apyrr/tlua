// @target: esnext
// @lib: luajit
// @strict: true
// @noEmit: true

// A function __index answers a read of every key its parameter admits, which is an index
// signature rather than a property: nothing names the keys it will be asked for.

// An `any` key could be a key of any domain, so it feeds string and number alike -- the
// rule a computed table key already follows.
local anyMt = { __index = function(t: table, k: any): string return "x"; end };
local a = setmetatable({ n = 1 }, anyMt);
local s1: string | nil = a.whatever;
local s2: string | nil = a[1];
local n1: number = a.n;

// A concrete key domain keeps to itself: this table answers number keys only.
local numMt = { __index = function(t: table, k: number): boolean return true; end };
local num = setmetatable({ n = 1 }, numMt);
local b1: boolean | nil = num[3];
local absent = num.missing;

// A literal key names a member the handler answers for, exactly as a prototype table would
// declare it: the handler is a virtual property, not an index signature over its domain.
local litMt = { __index = function(t: table, k: "a"): number return 1; end };
local lit = setmetatable({ n = 1 }, litMt);
local l1: number = lit.a;
local l2 = lit["zzz"];

// A multi-return __index truncates to its first value at the call boundary, as every other
// call does.
local packMt = { __index = function(t: table, k: any): (string, number) return "x", 1; end };
local pack = setmetatable({ n = 1 }, packMt);
local p1: string | nil = pack.anything;

// Overloads that answer the same key both apply: a read of such a key gets whichever one Lua
// dispatches to. Distinct literal keys stay distinct members.
declare overloaded: { __index: { (t: table, k: "a"): number; (t: table, k: "a"): string; (t: table, k: "b"): boolean } };
local ov = setmetatable({ n = 1 }, overloaded);
local either: number | string = ov.a;
local notJustNumber: number = ov.a;
local justB: boolean = ov.b;

// A virtual property satisfies an interface that requires it, with __newindex typing the write.
interface StateRef<T> { value: T; get(self: StateRef<T>): T }
function createState<T>(initial: T): StateRef<T>
    local value = initial
    return setmetatable({ get = function() return value end }, {
        __index = function(_, key: "value"): T return value end,
        __newindex = function(_, key: "value", next: T) value = next end,
    })
end
local ref = createState(1)
local v: number = ref.value
ref.value = 2
ref.value = "no"

// A mapped proxy whose members a literal-keyed handler produces needs no assertion either.
type Proxy = { [K in "x" | "y"]: (self: Proxy) => K }
declare build: (key: string) => any
local proxy: Proxy = setmetatable({}, { __index = function(_, key: "x" | "y") return build(key) end })

// The table's own members still win: a function __index only runs on a miss.
local own = setmetatable({ n = 1 }, anyMt);
local o1: number = own.n;
local o2: string = own.n;

// ...unless the member can be nil, which is the miss.
declare partial: { v?: number };
local fallsThrough = setmetatable(partial, anyMt);
local merged: number | string = fallsThrough.v;
