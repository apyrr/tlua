-- dropped: @target: es2015 directive (tlua defaults to latest target)

interface Base {
    [x: number]: { a: number; b: number }
    x: {
        a: number; b: number
    }
}

interface Derived extends Base {
    [x: string]: {
        a: number
    };

    y: {
        a: number;
    }
    -- error
    1: {
        a: number
    }
}
