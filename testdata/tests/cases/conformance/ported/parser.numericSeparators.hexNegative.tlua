-- ported from tests/cases/conformance/parser/ecmascript2021/numericSeparators/parser.numericSeparators.hexNegative.ts
-- dropped: @target: es2015 directive (pinned to esnext); bare literal expression statements rebound to `local _ =` (tlua disallows bare non-call/assignment expression statements)
-- dropped: emit coverage (noEmit) -- the parser's recovered malformed hexadecimal literals (`0x00_`, `0x01__11`, `0x___0111010_0101_1`) and the split-prefix recovery statement `X0101` are printed verbatim, which is not valid Lua. Error/type/symbol coverage is unaffected.

// @noEmit: true
// @target: esnext
// @filename: 1.tlua
local _ = 0x00_

// @filename: 2.tlua
local _ = 0x_110

// @filename: 3.tlua
local _ = 0_X0101

// @filename: 4.tlua
local _ = 0x01__11

// @filename: 5.tlua

local _ = 0X0110_0110__

// @filename: 6.tlua
local _ = 0x___0111010_0101_1
