-- ported from tests/cases/conformance/types/typeParameters/typeParameterLists/typeParameterConstModifiersReverseMappedTypes.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- dropped: @strict: true directive (strict checking is enabled by default)
-- dropped: test5 rest-parameter case (rest-tuple correlation is replaced by
--   generic packs, and const packs are rejected)
// @noEmit: true

declare test1: <const T>(obj: {
  [K in keyof T]: T[K];
}) => [T, typeof obj];

local result1 = test1({
  prop = "foo",
  nested = {
    nestedProp = "bar",
  },
})

declare test2: <const T>(obj: {
  readonly [K in keyof T]: T[K];
}) => [T, typeof obj];

local result2 = test2({
  prop = "foo",
  nested = {
    nestedProp = "bar",
  },
})

declare test3: <const T>(obj: {
  -readonly [K in keyof T]: T[K];
}) => [T, typeof obj];

local result3 = test3({
  prop = "foo",
  nested = {
    nestedProp = "bar",
  },
})

declare test4: <const T extends readonly unknown[]>(arr: {
  [K in keyof T]: T[K];
}) => T;

local result4 = test4({ "1", 2 })
