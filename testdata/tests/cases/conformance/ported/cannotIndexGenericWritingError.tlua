-- ported from tests/cases/compiler/cannotIndexGenericWritingError.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- dropped: symbol-key coverage (Lua tables use string and numeric keys here)

// @noEmit: true

-- From #47357

function foo<T extends { [s: string]: any }>(target: T, p: string)
    target[p] = "" -- error
end

function foo2<T extends { [n: number]: number; [s: string]: number | string }>(target: T, p: string | number)
    target[p] = 1 -- error
    target[1] = 1 -- ok
end
