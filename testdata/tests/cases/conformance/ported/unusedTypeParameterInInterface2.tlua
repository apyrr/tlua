-- ported from tests/cases/compiler/unusedTypeParameterInInterface2.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- compiler gap: the unused type parameter U is reported as expected (T and V are not), but tlua
-- additionally reports the top-level interface name int as unused; upstream reports only U

// @noUnusedLocals: true
// @noUnusedParameters: true

interface int<T, U, V> {
    f1(a: T): string
    c: V
}
