-- ported from tests/cases/conformance/types/nonPrimitive/nonPrimitiveConstraintOfIndexAccessType.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- dropped: @strict: true directive (tlua defaults to strict mode)
-- note: upstream null and undefined both map to tlua nil; g is retained as the single meaningful nil-constrained case and h is omitted as a duplicate.
-- dropped: emit coverage (noEmit) — generic indexed-access signatures currently leak typed syntax into Lua output

// @noEmit: true

function f<T extends table, P extends keyof T>(s: string, tp: T[P]): void
    tp = s
end
function g<T extends nil, P extends keyof T>(s: string, tp: T[P]): void
    tp = s
end
function i<T extends void, P extends keyof T>(s: string, tp: T[P]): void
    tp = s
end
function j<T extends never, P extends keyof T>(s: string, tp: T[P]): void
    tp = s
end
function k<T extends number, P extends keyof T>(s: string, tp: T[P]): void
    tp = s
end
function o<T extends string, P extends keyof T>(s: string, tp: T[P]): void
    tp = s
end
function l<T extends {}, P extends keyof T>(s: string, tp: T[P]): void
    tp = s
end
function m<T extends { a: number }, P extends keyof T>(s: string, tp: T[P]): void
    tp = s
end
function n<T extends { [s: string]: number }, P extends keyof T>(s: string, tp: T[P]): void
    tp = s
end
