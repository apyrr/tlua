-- ported from tests/cases/compiler/indexedAccessWithFreshObjectLiteral.ts
-- dropped: @target: es2015 and @strict directives (tlua uses the latest target and strict checking by default)

function foo(id: string)
    return ({
        a = 1,
        b = "",
        c = true
    })[id]
end

function bar(id: 'a' | 'b')
    return ({
        a = 1,
        b = "",
        c = false
    })[id]
end

function baz(id: '1' | '2')
    return ({
        ["1"] = 1,
        ["2"] = "",
        ["3"] = false
    })[id]
end

function qux(id: 1 | 2)
    return ({
        [1] = 1,
        [2] = "",
        [3] = false
    })[id]
end

function quux(id: 'a' | 'b' | 'z')
    return ({
        a = 1,
        b = "",
        c = false
    })[id]
end

function corge(id: string)
    return (({
        a = 123,
        b = ""
    }) as Record<string, number | string>)[id]
end

function grault(id: string)
    return (({
        a = 123,
        b = ""
    }) as { [k: string]: string | number })[id]
end
