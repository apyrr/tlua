-- ported from tests/cases/conformance/parser/ecmascript2021/numericSeparators/parser.numericSeparators.binaryNegative.ts
-- dropped: @target: es2015 directive (pinned to esnext); bare literal expression statements rebound to `local _ =` (tlua disallows bare non-call/assignment expression statements)
-- dropped: emit coverage (noEmit) -- the parser's recovered malformed binary literals (`0b00_`, `0b01__11`, `0b___0111010_0101_1`) and the split-prefix recovery statement `B0101` are printed verbatim, which is not valid Lua. Error/type/symbol coverage is unaffected.

// @noEmit: true
// @target: esnext
// @filename: 1.tlua
local _ = 0b00_;

// @filename: 2.tlua
local _ = 0b_110;

// @filename: 3.tlua
local _ = 0_B0101;

// @filename: 4.tlua
local _ = 0b01__11;

// @filename: 5.tlua

local _ = 0B0110_0110__;

// @filename: 6.tlua
local _ = 0b___0111010_0101_1;
