//// [tests/cases/compiler/tluaNumberKeyIndexDisjoint.tlua] ////

=== tluaNumberKeyIndexDisjoint.tlua ===
// Number and string index signatures are fully independent and may coexist
// with no "number index must be assignable to string index" constraint.
interface Both {
  [k: number]: string;
>k : number

  [k: string]: number;
>k : string
}
declare b: Both;
>b : Both

local n: string | nil = b[1];    // number index → string
>n : string | nil
>b[1] : string | nil
>b : Both
>1 : 1

local s: number | nil = b["x"];  // string index → number
>s : number | nil
>b["x"] : number | nil
>b : Both
>"x" : "x"

// A number index signature serves number-key access.
interface NumOnly {
  [k: number]: boolean;
>k : number
}
local nb: boolean | nil = (({} as NumOnly))[0];
>nb : boolean | nil
>(({} as NumOnly))[0] : boolean | nil
>(({} as NumOnly)) : NumOnly
>({} as NumOnly) : NumOnly
>{} as NumOnly : NumOnly
>{} : {}
>0 : 0

// A string-only index does NOT serve number-key access (disjoint).
interface StrOnly {
  [k: string]: boolean;
>k : string
}
declare so: StrOnly;
>so : StrOnly

local bad = so[0]; // error: number key not covered by string index
>bad : any
>so[0] : any
>so : StrOnly
>0 : 0

local okStr: boolean | nil = so["x"];
>okStr : boolean | nil
>so["x"] : boolean | nil
>so : StrOnly
>"x" : "x"

// Value-type mismatches between the two signatures are independent, not
// forced to agree (TS requires the number value assignable to the string
// value; tlua does not).
interface Mixed {
  [k: number]: string;
>k : number

  [k: string]: boolean;
>k : string
}
declare m: Mixed;
>m : Mixed

local mn: string | nil = m[0];
>mn : string | nil
>m[0] : string | nil
>m : Mixed
>0 : 0

local ms: boolean | nil = m["x"];
>ms : boolean | nil
>m["x"] : boolean | nil
>m : Mixed
>"x" : "x"

local es = {n, s, nb, bad, okStr, mn, ms};
>es : { 1: string | nil; 2: number | nil; 3: boolean | nil; 4: any; 5: boolean | nil; 6: string | nil; 7: boolean | nil; }
>{n, s, nb, bad, okStr, mn, ms} : { 1: string | nil; 2: number | nil; 3: boolean | nil; 4: any; 5: boolean | nil; 6: string | nil; 7: boolean | nil; }
>n : any
>s : any
>nb : any
>bad : any
>okStr : any
>mn : any
>ms : any

