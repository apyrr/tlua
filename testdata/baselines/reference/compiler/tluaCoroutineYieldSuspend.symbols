// The escape hatch: widening to the `function` top type drops the flag, so an
// untracked yield is still expressible.
local rawYield: function = coroutine.yield;
>rawYield : Symbol(rawYield, Decl(tluaCoroutineYieldSuspend.tlua, 65, 5))
>coroutine.yield : Symbol(CoroutineLib.yield, Decl(lib.luajit.d.tlua, --, --))
>coroutine : Symbol(coroutine, Decl(lib.luajit.d.tlua, --, --))
>yield : Symbol(CoroutineLib.yield, Decl(lib.luajit.d.tlua, --, --))

function untracked(): void
>untracked : Symbol(untracked, Decl(tluaCoroutineYieldSuspend.tlua, 65, 43))

  rawYield(1);
>rawYield : Symbol(rawYield, Decl(tluaCoroutineYieldSuspend.tlua, 65, 5))

end

