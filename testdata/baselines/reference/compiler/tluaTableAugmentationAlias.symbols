>deferredRoot.value : Symbol(value, Decl(tluaTableAugmentationAlias.tlua, 79, 18))
>deferredRoot : Symbol(deferredRoot, Decl(tluaTableAugmentationAlias.tlua, 78, 5))
>value : Symbol(value, Decl(tluaTableAugmentationAlias.tlua, 79, 18))

// Conditional initialization is the same shape: the declaration and the first
// store are necessarily separate statements.
local conditionalRoot;
>conditionalRoot : Symbol(conditionalRoot, Decl(tluaTableAugmentationAlias.tlua, 85, 5))

if condition() then
>condition : Symbol(condition, Decl(tluaTableAugmentationAlias.tlua, 0, 0))

  conditionalRoot = {};
>conditionalRoot : Symbol(conditionalRoot, Decl(tluaTableAugmentationAlias.tlua, 85, 5))

else
  conditionalRoot = {};
>conditionalRoot : Symbol(conditionalRoot, Decl(tluaTableAugmentationAlias.tlua, 85, 5))

end
conditionalRoot.name = "chosen";
