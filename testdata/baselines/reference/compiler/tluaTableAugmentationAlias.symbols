>listReassigned : Symbol(listReassigned, Decl(tluaTableAugmentationAlias.tlua, 70, 5))
>value : Symbol(value, Decl(tluaTableAugmentationAlias.tlua, 71, 33))

local listReassignedUse: string = listReassigned.value;
>listReassignedUse : Symbol(listReassignedUse, Decl(tluaTableAugmentationAlias.tlua, 73, 5))
>listReassigned.value : Symbol(value, Decl(tluaTableAugmentationAlias.tlua, 71, 33))
>listReassigned : Symbol(listReassigned, Decl(tluaTableAugmentationAlias.tlua, 70, 5))
>value : Symbol(value, Decl(tluaTableAugmentationAlias.tlua, 71, 33))

// A local declared before its first store takes the constructor from that
// store. `{}` builds an empty table and an empty array alike, so a member
// declared under a named key is what settles which one this is.
local deferredRoot;
>deferredRoot : Symbol(deferredRoot, Decl(tluaTableAugmentationAlias.tlua, 78, 5))

deferredRoot = {};
>deferredRoot : Symbol(deferredRoot, Decl(tluaTableAugmentationAlias.tlua, 78, 5))

deferredRoot.value = true;
