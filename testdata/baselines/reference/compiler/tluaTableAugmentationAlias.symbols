local listReassigned = {};
>listReassigned : Symbol(listReassigned, Decl(tluaTableAugmentationAlias.tlua, 70, 5))

listReassigned, listSide = {}, 0;
>listReassigned : Symbol(listReassigned, Decl(tluaTableAugmentationAlias.tlua, 70, 5))
>listSide : Symbol(listSide, Decl(tluaTableAugmentationAlias.tlua, 71, 15))

listReassigned.value = "list";
