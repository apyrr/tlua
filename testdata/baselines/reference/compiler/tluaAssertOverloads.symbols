>w : Symbol(w, Decl(tluaAssertOverloads.tlua, 22, 7))

local w1: string = w
>w1 : Symbol(w1, Decl(tluaAssertOverloads.tlua, 24, 5))
>w : Symbol(w, Decl(tluaAssertOverloads.tlua, 22, 7))

// Reachability: an untyped assertion of false ends the flow only when it is the pick.
local function dead1(): number
>dead1 : Symbol(dead1, Decl(tluaAssertOverloads.tlua, 24, 20))

  both(false, 1)
>both : Symbol(both, Decl(tluaAssertOverloads.tlua, 17, 20), Decl(tluaAssertOverloads.tlua, 20, 57))

end
