// Overloads that all assert the same argument untyped narrow alike.
declare function both(v: unknown, tag: string): asserts v
>both : Symbol(both, Decl(tluaAssertOverloads.tlua, 17, 20), Decl(tluaAssertOverloads.tlua, 20, 57))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 20, 22))
>tag : Symbol(tag, Decl(tluaAssertOverloads.tlua, 20, 33))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 20, 22))

declare function both(v: unknown, tag: number): asserts v
>both : Symbol(both, Decl(tluaAssertOverloads.tlua, 17, 20), Decl(tluaAssertOverloads.tlua, 20, 57))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 21, 22))
>tag : Symbol(tag, Decl(tluaAssertOverloads.tlua, 21, 33))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 21, 22))

declare w: string | nil
>w : Symbol(w, Decl(tluaAssertOverloads.tlua, 22, 7))

both(w, 1)
