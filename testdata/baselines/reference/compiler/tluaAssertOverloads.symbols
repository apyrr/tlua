// Typed assertion overloads narrow by the overload the call picks.
declare function chk(v: unknown, tag: string): asserts v is string
>chk : Symbol(chk, Decl(tluaAssertOverloads.tlua, 0, 0), Decl(tluaAssertOverloads.tlua, 1, 66))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 1, 21))
>tag : Symbol(tag, Decl(tluaAssertOverloads.tlua, 1, 32))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 1, 21))

declare function chk(v: unknown, tag: number): asserts v is number
>chk : Symbol(chk, Decl(tluaAssertOverloads.tlua, 0, 0), Decl(tluaAssertOverloads.tlua, 1, 66))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 2, 21))
>tag : Symbol(tag, Decl(tluaAssertOverloads.tlua, 2, 32))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 2, 21))

declare x: unknown
>x : Symbol(x, Decl(tluaAssertOverloads.tlua, 3, 7))

chk(x, 1)
>chk : Symbol(chk, Decl(tluaAssertOverloads.tlua, 0, 0), Decl(tluaAssertOverloads.tlua, 1, 66))
>x : Symbol(x, Decl(tluaAssertOverloads.tlua, 3, 7))

local n: number = x
>n : Symbol(n, Decl(tluaAssertOverloads.tlua, 5, 5))
>x : Symbol(x, Decl(tluaAssertOverloads.tlua, 3, 7))

declare y: unknown
>y : Symbol(y, Decl(tluaAssertOverloads.tlua, 6, 7))

chk(y, "s")
>chk : Symbol(chk, Decl(tluaAssertOverloads.tlua, 0, 0), Decl(tluaAssertOverloads.tlua, 1, 66))
>y : Symbol(y, Decl(tluaAssertOverloads.tlua, 6, 7))

local s: string = y
>s : Symbol(s, Decl(tluaAssertOverloads.tlua, 8, 5))
>y : Symbol(y, Decl(tluaAssertOverloads.tlua, 6, 7))

// An overload that asserts nothing narrows nothing.
declare function maybe(v: unknown, tag: string): asserts v
>maybe : Symbol(maybe, Decl(tluaAssertOverloads.tlua, 8, 19), Decl(tluaAssertOverloads.tlua, 11, 58))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 11, 23))
>tag : Symbol(tag, Decl(tluaAssertOverloads.tlua, 11, 34))
>v : Symbol(v, Decl(tluaAssertOverloads.tlua, 11, 23))

