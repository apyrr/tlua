>live1 : Symbol(live1, Decl(tluaAssertOverloads.tlua, 29, 3))

  maybe(false, 1)
>maybe : Symbol(maybe, Decl(tluaAssertOverloads.tlua, 8, 19), Decl(tluaAssertOverloads.tlua, 11, 58))

end
