=== tluaMetatableLateMembers.tlua ===
// setmetatable returns its table, so a local initialized with the call is the
// table: members written to it afterward -- the prototype idiom -- are members of
// the table, and reads through the pairing still see them.
local Builder = { build = function(self: { name: string }) return self.name end }
>Builder : { build: (self: { name: string; }) => string; }
>{ build = function(self: { name: string }) return self.name end } : { build: (self: { name: string; }) => string; }
>build : (self: { name: string; }) => string
>function(self: { name: string }) return self.name end : (self: { name: string; }) => string
>self : { name: string; }
>name : string
>self.name : string
>self : { name: string; }
>name : string

local Panel = setmetatable({}, { __index = Builder })
>Panel : { build: (self: { name: string; }) => string; panel(self: table): number; }
>setmetatable({}, { __index = Builder }) : { build: (self: { name: string; }) => string; panel(self: table): number; }
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<NoInfer<T>> | nil) => T
>{} : { panel(self: table): number; }
>{ __index = Builder } : { __index: { build: (self: { name: string; }) => string; }; }
>__index : { build: (self: { name: string; }) => string; }
>Builder : { build: (self: { name: string; }) => string; }

function Panel.panel(self: table) return 1 end
>Panel : { build: (self: { name: string; }) => string; panel(self: table): number; }
>panel : (self: table) => number
>self : table
>1 : 1

local Stack = setmetatable({}, { __index = Panel })
