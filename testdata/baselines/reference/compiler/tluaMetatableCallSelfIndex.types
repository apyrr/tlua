  __index = Tx,
>__index : { query(self: Transaction, sql: string): table[]; }
>Tx : { query(self: Transaction, sql: string): table[]; }

  __call = suspend function(self: Transaction, sql: string)
>__call : suspend (self: Transaction, sql: string) => table[]
>suspend function(self: Transaction, sql: string)    return Tx.query(self, sql);  end : suspend (self: Transaction, sql: string) => table[]
>self : Transaction
>sql : string

    return Tx.query(self, sql);
>Tx.query(self, sql) : table[]
>Tx.query : (self: Transaction, sql: string) => table[]
>Tx : { query(self: Transaction, sql: string): table[]; }
>query : (self: Transaction, sql: string) => table[]
>self : Transaction
