//// [tests/cases/compiler/tluaMetatableCallSelfIndex.tlua] ////

=== tluaMetatableCallSelfIndex.tlua ===
// A metamethod receives the PAIRED table, not the bare one setmetatable was handed: at runtime
// the fallback behind __index answers for it too. So a metatable literal that commits to a
// table-valued __index contextually types every metamethod's first parameter as the table
// intersected with that fallback. And the table operand alone chooses T: a metamethod annotated
// with a wider receiver states what it accepts, never what the call is pairing.

interface Transaction {
  id: string;
>id : string

  query(self: Transaction, sql: string): table[];
>query : (self: Transaction, sql: string) => table[]
>self : Transaction
>sql : string
}

local Tx = {};
>Tx : { query(self: Transaction, sql: string): table[]; }
>{} : { query(self: Transaction, sql: string): table[]; }

function Tx.query(self: Transaction, sql: string): table[]
>Tx : { query(self: Transaction, sql: string): table[]; }
>query : (self: Transaction, sql: string) => table[]
>self : Transaction
>sql : string

  return {};
>{} : {}

end

// (1) The unannotated receiver sees the fallback, so it satisfies Transaction.
local state = { id = "test" };
>state : { id: string; }
>{ id = "test" } : { id: string; }
>id : string
>"test" : "test"

local tx = setmetatable(state, {
>tx : { (sql: string): table[]; query(self: Transaction, sql: string): table[]; id: string; }
>setmetatable(state, {  __index = Tx,  __call = suspend function(self, sql: string)    return Tx.query(self, sql);  end,}) : { (sql: string): table[]; query(self: Transaction, sql: string): table[]; id: string; }
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<NoInfer<T>> | nil) => T
>state : { id: string; }
>{  __index = Tx,  __call = suspend function(self, sql: string)    return Tx.query(self, sql);  end,} : { __index: { query(self: Transaction, sql: string): table[]; }; __call: suspend (self: { id: string; } & { query(self: Transaction, sql: string): table[]; }, sql: string) => table[]; }

  __index = Tx,
>__index : { query(self: Transaction, sql: string): table[]; }
>Tx : { query(self: Transaction, sql: string): table[]; }

  __call = suspend function(self, sql: string)
>__call : suspend (self: { id: string; } & { query(self: Transaction, sql: string): table[]; }, sql: string) => table[]
>suspend function(self, sql: string)    return Tx.query(self, sql);  end : suspend (self: { id: string; } & { query(self: Transaction, sql: string): table[]; }, sql: string) => table[]
>self : { id: string; } & { query(self: Transaction, sql: string): table[]; }
>sql : string

    return Tx.query(self, sql);
>Tx.query(self, sql) : table[]
>Tx.query : (self: Transaction, sql: string) => table[]
>Tx : { query(self: Transaction, sql: string): table[]; }
>query : (self: Transaction, sql: string) => table[]
>self : { id: string; } & { query(self: Transaction, sql: string): table[]; }
>sql : string

  end,
});

suspend function useTx(): void
>useTx : suspend () => void

  local rows: table[] = tx("select 1");
>rows : table[]
>tx("select 1") : table[]
>tx : { (sql: string): table[]; query(self: Transaction, sql: string): table[]; id: string; }
>"select 1" : "select 1"

  local id: string = tx.id;
>id : string
>tx.id : string
>tx : { (sql: string): table[]; query(self: Transaction, sql: string): table[]; id: string; }
>id : string

  local viaFallback: table[] = tx.query(tx, "select 2");
>viaFallback : table[]
>tx.query(tx, "select 2") : table[]
>tx.query : (self: Transaction, sql: string) => table[]
>tx : { (sql: string): table[]; query(self: Transaction, sql: string): table[]; id: string; }
>query : (self: Transaction, sql: string) => table[]
>tx : { (sql: string): table[]; query(self: Transaction, sql: string): table[]; id: string; }
>"select 2" : "select 2"

end

