>function(self, k: number): string    local own: number = self.n;    return self.describe(self);  end : (self: { n: number; } & { describe: (self: table) => string; }, k: number) => string
>self : { n: number; } & { describe: (self: table) => string; }
>k : number

    local own: number = self.n;
>own : number
>self.n : number
>self : { n: number; } & { describe: (self: table) => string; }
>n : number

    return self.describe(self);
>self.describe(self) : string
>self.describe : (self: table) => string
>self : { n: number; } & { describe: (self: table) => string; }
