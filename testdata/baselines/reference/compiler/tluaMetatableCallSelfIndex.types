>annotated : { (sql: string): table[]; query(self: Transaction, sql: string): table[]; id: string; }
>setmetatable({ id = "test" }, {  __index = Tx,  __call = suspend function(self: Transaction, sql: string)    return Tx.query(self, sql);  end,}) : { (sql: string): table[]; query(self: Transaction, sql: string): table[]; id: string; }
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<NoInfer<T>> | nil) => T
>{ id = "test" } : { id: string; }
>id : string
>"test" : "test"
