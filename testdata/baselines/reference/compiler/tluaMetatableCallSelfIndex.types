// (3) The statement form freezes the literal through the declared-pairing replay, which must
// supply the same contract the call site would.
local Methods = { describe = function(self: table): string return "d"; end };
>Methods : { describe: (self: table) => string; }
>{ describe = function(self: table): string return "d"; end } : { describe: (self: table) => string; }
>describe : (self: table) => string
>function(self: table): string return "d"; end : (self: table) => string
>self : table
>"d" : "d"

