//// [tests/cases/compiler/tluaMetatableCallSuspend.tlua] ////

=== tluaMetatableCallSuspend.tlua ===
// A suspend __call pairs the same way a sync one does: the receiver drops out, and the call
// carries the coroutine contract, so only a suspend context may invoke it.

local execute = suspend function(query: string): table[]
>execute : suspend (query: string) => table[]
>suspend function(query: string): table[]  return {};end : suspend (query: string) => table[]
>query : string

  return {};
>{} : never[]

end;

// The assign form.
local sqlAssigned = setmetatable({}, {
>sqlAssigned : suspend (query: string) => table[]
>setmetatable({}, {  __call = suspend function(self: table, query: string): table[]    return execute(query);  end,}) : suspend (query: string) => table[]
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<NoInfer<T>> | nil) => T
>{} : {}
>{  __call = suspend function(self: table, query: string): table[]    return execute(query);  end,} : { __call: (self: table, query: string) => table[]; }

  __call = suspend function(self: table, query: string): table[]
>__call : suspend (self: table, query: string) => table[]
>suspend function(self: table, query: string): table[]    return execute(query);  end : suspend (self: table, query: string) => table[]
>self : table
>query : string

    return execute(query);
>execute(query) : table[]
>execute : suspend (query: string) => table[]
>query : string

  end,
});

// The statement form, mutating in place. The receiver picks up its type from the __call slot.
local sql = {};
>sql : {}
>{} : {}

setmetatable(sql, {
>setmetatable(sql, {  __call = suspend function(_self, query: string)    return execute(query);  end,}) : suspend (query: string) => table[]
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<NoInfer<T>> | nil) => T
>sql : {}
>{  __call = suspend function(_self, query: string)    return execute(query);  end,} : { __call: suspend (_self: {}, query: string) => table[]; }

  __call = suspend function(_self, query: string)
>__call : suspend (_self: {}, query: string) => table[]
>suspend function(_self, query: string)    return execute(query);  end : suspend (_self: {}, query: string) => table[]
>_self : {}
>query : string

    return execute(query);
>execute(query) : table[]
>execute : suspend (query: string) => table[]
>query : string

  end,
});

// Own members survive next to the call surface.
local api = { begin = function(self: table): number return 1; end };
>api : { begin: (self: table) => number; }
>{ begin = function(self: table): number return 1; end } : { begin: (self: table) => number; }
>begin : (self: table) => number
>function(self: table): number return 1; end : (self: table) => number
>self : table
>1 : 1

setmetatable(api, {
>setmetatable(api, {  __call = suspend function(self: table, query: string): table[]    return execute(query);  end,}) : { (query: string): table[]; begin: (self: table) => number; }
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<NoInfer<T>> | nil) => T
>api : { begin: (self: table) => number; }
>{  __call = suspend function(self: table, query: string): table[]    return execute(query);  end,} : { __call: (self: table, query: string) => table[]; }

  __call = suspend function(self: table, query: string): table[]
>__call : suspend (self: table, query: string) => table[]
>suspend function(self: table, query: string): table[]    return execute(query);  end : suspend (self: table, query: string) => table[]
>self : table
>query : string

    return execute(query);
>execute(query) : table[]
>execute : suspend (query: string) => table[]
>query : string

  end,
});

suspend function use(): void
>use : suspend () => void

  local rows: table[] = sqlAssigned("SELECT 1");
>rows : table[]
>sqlAssigned("SELECT 1") : table[]
>sqlAssigned : suspend (query: string) => table[]
>"SELECT 1" : "SELECT 1"

  local rows2: table[] = sql("SELECT 1");
>rows2 : table[]
>sql("SELECT 1") : table[]
>sql : suspend (query: string) => table[]
>"SELECT 1" : "SELECT 1"

  local n: number = api.begin(api);
>n : number
>api.begin(api) : number
>api.begin : (self: table) => number
>api : { (query: string): table[]; begin: (self: table) => number; }
>begin : (self: table) => number
>api : { (query: string): table[]; begin: (self: table) => number; }

  local rows3: table[] = api("SELECT 1");
>rows3 : table[]
>api("SELECT 1") : table[]
>api : { (query: string): table[]; begin: (self: table) => number; }
>"SELECT 1" : "SELECT 1"

end

// The contract holds through the pairing: a sync context may not invoke a suspend __call.
function syncUse(): void
>syncUse : () => void

  local rows = sql("SELECT 1");
>rows : table[]
>sql("SELECT 1") : table[]
>sql : suspend (query: string) => table[]
>"SELECT 1" : "SELECT 1"

  local rowsAssigned = sqlAssigned("SELECT 1");
>rowsAssigned : table[]
>sqlAssigned("SELECT 1") : table[]
>sqlAssigned : suspend (query: string) => table[]
>"SELECT 1" : "SELECT 1"

  local rowsApi = api("SELECT 1");
>rowsApi : table[]
>api("SELECT 1") : table[]
>api : { (query: string): table[]; begin: (self: table) => number; }
>"SELECT 1" : "SELECT 1"

end
sql("top level");
>sql("top level") : table[]
>sql : suspend (query: string) => table[]
>"top level" : "top level"

// The receiver is implicit, so passing it back is one argument too many.
suspend function tooMany(): void
>tooMany : suspend () => void

  sqlAssigned(sqlAssigned, "SELECT 1");
>sqlAssigned(sqlAssigned, "SELECT 1") : table[]
>sqlAssigned : suspend (query: string) => table[]
>sqlAssigned : suspend (query: string) => table[]
>"SELECT 1" : "SELECT 1"

end

