>text.upper(text) : string
>text.upper : (self: string) => string
>text : string
>upper : (self: string) => string
>text : string

// The namespace form is unchanged: it names the receiver as an ordinary
// argument.
local nsPiece: string = string.sub(text, 1, 5);
>nsPiece : string
>string.sub(text, 1, 5) : string
>string.sub : (value: string, i: number, j?: number) => string
>string : StringLib
>sub : (value: string, i: number, j?: number) => string
>text : string
>1 : 1
>5 : 5

// Arity and argument types are now measured against the receiver's slot, so a
// colon call reports the WRITTEN argument that is wrong.
text:sub("one");
>text:sub("one") : string
>text:sub : (self: string, i: number, j?: number) => string
>text : string
>sub : (self: string, i: number, j?: number) => string
>"one" : "one"

text:upper(1);
>text:upper(1) : string
>text:upper : (self: string) => string
>text : string
>upper : (self: string) => string
>1 : 1

// A dot call that forgets the receiver is a plain argument mismatch.
text.upper();
>text.upper() : string
>text.upper : (self: string) => string
>text : string
>upper : (self: string) => string

text.sub(1, 5);
>text.sub(1, 5) : string
>text.sub : (self: string, i: number, j?: number) => string
>text : string
>sub : (self: string, i: number, j?: number) => string
>1 : 1
>5 : 5

