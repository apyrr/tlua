//// [tests/cases/compiler/tluaIndexKeyGeneric.tlua] ////

=== tluaIndexKeyGeneric.tlua ===
// A Lua table is keyed by any non-nil value, so an index signature may be keyed by a
// type parameter. This is what makes `Table<K, V>` -- and every standard library
// signature built on it -- mean anything.

interface Map2<K, V> {
  [key: K]: V;
>key : K
}

// The key instantiates along with the value.
declare byName: Map2<string, number>;
>byName : Map2<string, number>

local n: number | nil = byName["a"];
>n : number | nil
>byName["a"] : number | nil
>byName : Map2<string, number>
>"a" : "a"

declare byPoint: Map2<{ x: number }, string>;
>byPoint : Map2<{ x: number; }, string>
>x : number

declare pt: { x: number };
>pt : { x: number; }
>x : number

local s: string | nil = byPoint[pt];
>s : string | nil
>byPoint[pt] : string | nil
>byPoint : Map2<{ x: number; }, string>
>pt : { x: number; }

// keyof yields the key itself, not string | number | symbol.
type K1 = keyof Map2<string, number>;
>K1 : string

local k1: K1 = "a";
>k1 : string
>"a" : "a"

type K2 = keyof Map2<boolean, number>;
>K2 : boolean

local k2: K2 = true;
>k2 : boolean
>true : true

// The index resolves inside a generic body: `Table<K, V>[K]` is `V`, never a deferred
// indexed access nothing can simplify. Resolving it keeps the read widening: an index
// signature keyed by a type parameter is as open as any other, so the value is `V | nil`
// and a helper that means to hand the absence back says so.
function get<K, V>(t: Table<K, V>, k: K): V | nil
>get : <K, V>(t: Table<K, V>, k: K) => V | nil
>t : Table<K, V>
>k : K

  local v = t[k];
>v : Table<K, V>[K]
>t[k] : Table<K, V>[K]
>t : Table<K, V>
>k : K

  return v;
>v : Table<K, V>[K]

end

// The same read through a number index, for contrast -- the generic key is not what
// carries the nil, the index signature is.
function at<T>(a: T[], i: number): T | nil
>at : <T>(a: T[], i: number) => T | nil
>a : T[]
>i : number

  return a[i];
>a[i] : T | nil
>a : T[]
>i : number

end

// A helper that will not hand the absence back narrows it away first.
function getOr<K, V>(t: Table<K, V>, k: K, fallback: V): V
>getOr : <K, V>(t: Table<K, V>, k: K, fallback: V) => V
>t : Table<K, V>
>k : K
>fallback : V

  local v = t[k];
>v : Table<K, V>[K]
>t[k] : Table<K, V>[K]
>t : Table<K, V>
>k : K

  if v == nil then
>v == nil : boolean
>v : Table<K, V>[K]

    return fallback;
>fallback : V

  end
  return v;
>v : NonNullable<Table<K, V>[K]>

end

function set<K, V>(t: Table<K, V>, k: K, v: V): void
>set : <K, V>(t: Table<K, V>, k: K, v: V) => void
>t : Table<K, V>
>k : K
>v : V

  t[k] = v;
>t[k] = v : V
>t[k] : Table<K, V>[K]
>t : Table<K, V>
>k : K
>v : V

end

// A readonly index stays readonly in a generic body. Readonly governs the write; the
// read still widens, because a frozen table is no less open than any other.
interface ReadonlyTable<K, V> { readonly [key: K]: V }
>key : K

function readOk<K, V>(t: ReadonlyTable<K, V>, k: K): V | nil
>readOk : <K, V>(t: ReadonlyTable<K, V>, k: K) => V | nil
>t : ReadonlyTable<K, V>
>k : K

  return t[k];
>t[k] : ReadonlyTable<K, V>[K]
>t : ReadonlyTable<K, V>
>k : K

end
function writeNotOk<K, V>(t: ReadonlyTable<K, V>, k: K, v: V): void
>writeNotOk : <K, V>(t: ReadonlyTable<K, V>, k: K, v: V) => void
>t : ReadonlyTable<K, V>
>k : K
>v : V

  t[k] = v;
>t[k] = v : V
>t[k] : ReadonlyTable<K, V>[K]
>t : ReadonlyTable<K, V>
>k : K
>v : V

end

// A union key still simplifies when every index carries the same value.
function getEither<K, V>(t: Table<K | string, V>, k: K): V | nil
>getEither : <K, V>(t: Table<K | string, V>, k: K) => V | nil
>t : Table<string | K, V>
>k : K

  return t[k];
>t[k] : Table<string | K, V>[K]
>t : Table<string | K, V>
>k : K

end

// A union *index* distributes into one access per constituent. Each one is resolved
// under the flags of the access it came from, so the nil survives the split.
function getEitherKey<A, B, V>(t: Table<A | B, V>, k: A | B): V | nil
>getEitherKey : <A, B, V>(t: Table<A | B, V>, k: A | B) => V | nil
>t : Table<A | B, V>
>k : A | B

  return t[k];
>t[k] : Table<A | B, V>[A | B]
>t : Table<A | B, V>
>k : A | B

end

// Simplifying the deferred access must preserve the read widening through an object
// union. The named arm is known-present; only the index-signature arm contributes nil.
interface OpenStringTable { [key: string]: number }
>key : string

type OpenOrNamed = OpenStringTable | { x: boolean };
>OpenOrNamed : OpenOrNamed
>x : boolean

function getFromUnion<T extends OpenOrNamed>(t: T): number | boolean | nil
>getFromUnion : <T extends OpenOrNamed>(t: T) => number | boolean | nil
>t : T

  return t["x"];
>t["x"] : number | boolean | nil
>t : OpenOrNamed
>"x" : "x"

end
function getFromUnionUnsafe<T extends OpenOrNamed>(t: T): number | boolean
>getFromUnionUnsafe : <T extends OpenOrNamed>(t: T) => number | boolean
>t : T

  return t["x"];
>t["x"] : number | boolean | nil
>t : OpenOrNamed
>"x" : "x"

end
type BothNamed = { x: number } | { x: boolean };
>BothNamed : BothNamed
>x : number
>x : boolean

function getFromNamedUnion<T extends BothNamed>(t: T): number | boolean
>getFromNamedUnion : <T extends BothNamed>(t: T) => number | boolean
>t : T

  return t["x"];
>t["x"] : number | boolean
>t : BothNamed
>"x" : "x"

end

// A generic mapped access needs the same treatment when its key can become an index
// signature. A finite literal-key mapping still consists of known-present properties.
type MappedTable<K, V> = { [P in K]: V };
>MappedTable : MappedTable<K, V>

function getMapped<K extends string, V>(t: MappedTable<K, V>, k: K): V | nil
>getMapped : <K extends string, V>(t: MappedTable<K, V>, k: K) => V | nil
>t : MappedTable<K, V>
>k : K

  return t[k];
>t[k] : MappedTable<K, V>[K]
>t : MappedTable<K, V>
>k : K

end
function getMappedUnsafe<K extends string, V>(t: MappedTable<K, V>, k: K): V
>getMappedUnsafe : <K extends string, V>(t: MappedTable<K, V>, k: K) => V
>t : MappedTable<K, V>
>k : K

  return t[k];
>t[k] : MappedTable<K, V>[K]
>t : MappedTable<K, V>
>k : K

end
function getFiniteMapped<K extends "x" | "y", V>(t: MappedTable<K, V>, k: K): V
>getFiniteMapped : <K extends "x" | "y", V>(t: MappedTable<K, V>, k: K) => V
>t : MappedTable<K, V>
>k : K

  return t[k];
>t[k] : MappedTable<K, V>[K]
>t : MappedTable<K, V>
>k : K

end
type ConcreteStringMap = { [P in string]: number };
>ConcreteStringMap : ConcreteStringMap

function getConcreteMapped<K extends string>(t: ConcreteStringMap, k: K): number | nil
>getConcreteMapped : <K extends string>(t: ConcreteStringMap, k: K) => number | nil
>t : ConcreteStringMap
>k : K

  return t[k];
>t[k] : number | nil
>t : ConcreteStringMap
>k : K

end
function getConcreteMappedUnsafe<K extends string>(t: ConcreteStringMap, k: K): number
>getConcreteMappedUnsafe : <K extends string>(t: ConcreteStringMap, k: K) => number
>t : ConcreteStringMap
>k : K

  return t[k];
>t[k] : number | nil
>t : ConcreteStringMap
>k : K

end
type ConcreteFiniteMap = { [P in "x" | "y"]: number };
>ConcreteFiniteMap : ConcreteFiniteMap

function getConcreteFiniteMapped<K extends keyof ConcreteFiniteMap>(t: ConcreteFiniteMap, k: K): number
>getConcreteFiniteMapped : <K extends keyof ConcreteFiniteMap>(t: ConcreteFiniteMap, k: K) => number
>t : ConcreteFiniteMap
>k : K

  return t[k];
>t[k] : ConcreteFiniteMap[K]
>t : ConcreteFiniteMap
>k : K

end

// A union key instantiates to two disjoint indexes, not one union-keyed index.
declare both: Map2<string | number, boolean>;
>both : Map2<string | number, boolean>

local b1: boolean | nil = both["a"];
>b1 : boolean | nil
>both["a"] : boolean | nil
>both : Map2<string | number, boolean>
>"a" : "a"

local b2: boolean | nil = both[1];
>b2 : boolean | nil
>both[1] : boolean | nil
>both : Map2<string | number, boolean>
>1 : 1

// The whole point: the standard library comes alive. The key keeps its literal names --
// `"a" | "b"`, exactly what `keyof m` reports -- rather than widening to string.
local m = { a = 1, b = 2 };
>m : { a: number; b: number; }
>{ a = 1, b = 2 } : { a: number; b: number; }
>a : number
>1 : 1
>b : number
>2 : 2

for k, v in pairs(m) do
>k : "a" | "b"
>v : number
>pairs(m) : LuaPairsIterator<"a" | "b", number>
>pairs : <K, V>(value: Table<K, V>) => (LuaPairsIterator<K, V>, Table<K, V>, nil)
>m : { a: number; b: number; }

  local key: "a" | "b" = k;
>key : "a" | "b"
>k : "a" | "b"

  local alsoAString: string = k;
>alsoAString : string
>k : "a" | "b"

  local value: number = v;
>value : number
>v : number

end

local got: number | nil = rawget(m, "a");
>got : number | nil
>rawget(m, "a") : number | nil
>rawget : <K, V>(value: Table<K, V>, index: K) => V | nil
>m : { a: number; b: number; }
>"a" : "a"

// A supplied key wins over the table's own keys (it is inferred at the priority a
// mapped type constraint uses), so adding a key a table does not have yet -- rawset is
// how a key is added, in any domain -- always type-checks: a Lua table is open.
rawset(m, "c", 3);
>rawset(m, "c", 3) : Table<string, number>
>rawset : <K, V>(value: Table<K, V>, index: K, item: V) => Table<K, V>
>m : { a: number; b: number; }
>"c" : "c"
>3 : 3

rawset(m, 5, 3);
>rawset(m, 5, 3) : Table<number, number>
>rawset : <K, V>(value: Table<K, V>, index: K, item: V) => Table<K, V>
>m : { a: number; b: number; }
>5 : 5
>3 : 3

// A recursive table type, spelled by name.
type RecTable = Table<string, RecTable | number>;
>RecTable : RecTable

declare rt: RecTable;
>rt : RecTable

local rec = rt["x"];
>rec : number | RecTable | nil
>rt["x"] : number | RecTable | nil
>rt : RecTable
>"x" : "x"

// A number-keyed table iterates with ipairs.
local arr = { 10, 20, 30 };
>arr : { 1: number; 2: number; 3: number; }
>{ 10, 20, 30 } : { 1: number; 2: number; 3: number; }

for i, v in ipairs(arr) do
>i : number
>v : number
>ipairs(arr) : LuaIPairsIterator<number>
>ipairs : <T>(value: Table<number, T>) => (LuaIPairsIterator<T>, Table<number, T>, number)
>arr : { 1: number; 2: number; 3: number; }

  local index: number = i;
>index : number
>i : number

  local element: number = v;
>element : number
>v : number

end

