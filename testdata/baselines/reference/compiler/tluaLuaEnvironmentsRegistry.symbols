}
interface ENT extends Entity {
>ENT : Symbol(ENT, Decl(host.d.tlua, 2, 1))
>Entity : Symbol(Entity, Decl(host.d.tlua, 0, 0))

    PrintName: string;
>PrintName : Symbol(ENT.PrintName, Decl(host.d.tlua, 3, 30))
}
interface EFFECT {}
>EFFECT : Symbol(EFFECT, Decl(host.d.tlua, 5, 1))

interface Effects {}
>Effects : Symbol(Effects, Decl(host.d.tlua, 6, 19))

interface ScriptedEntities {
>ScriptedEntities : Symbol(ScriptedEntities, Decl(host.d.tlua, 7, 20))

    // An explicit declaration keeps its own type.
    base_anim: ENT;
>base_anim : Symbol(ScriptedEntities.base_anim, Decl(host.d.tlua, 8, 28))
>ENT : Symbol(ENT, Decl(host.d.tlua, 2, 1))
}
// One signature, so the lookup does not depend on overload order across
// merged declarations.
interface EntsLib {
>EntsLib : Symbol(EntsLib, Decl(host.d.tlua, 11, 1))

    FindByClass<K extends string>(name: K): (K extends keyof ScriptedEntities ? ScriptedEntities[K] : Entity)[];
>FindByClass : Symbol(EntsLib.FindByClass, Decl(host.d.tlua, 14, 19))
>K : Symbol(K, Decl(host.d.tlua, 15, 16))
>name : Symbol(name, Decl(host.d.tlua, 15, 34))
>K : Symbol(K, Decl(host.d.tlua, 15, 16))
>K : Symbol(K, Decl(host.d.tlua, 15, 16))
>ScriptedEntities : Symbol(ScriptedEntities, Decl(host.d.tlua, 7, 20))
>ScriptedEntities : Symbol(ScriptedEntities, Decl(host.d.tlua, 7, 20))
>K : Symbol(K, Decl(host.d.tlua, 15, 16))
>Entity : Symbol(Entity, Decl(host.d.tlua, 0, 0))
}
declare ents: EntsLib
>ents : Symbol(ents, Decl(host.d.tlua, 17, 7))
>EntsLib : Symbol(EntsLib, Decl(host.d.tlua, 11, 1))

