>x : Symbol(x, Decl(tluaConstTypeParameters.tlua, 21, 48))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 21, 13))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 21, 13))

local mt = mut({ 1, 2 })
>mt : Symbol(mt, Decl(tluaConstTypeParameters.tlua, 22, 5))
>mut : Symbol(mut, Decl(tluaConstTypeParameters.tlua, 20, 7))

mt[1] = 5
>mt : Symbol(mt, Decl(tluaConstTypeParameters.tlua, 22, 5))
>1 : Symbol(1)

