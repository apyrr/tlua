//// [tests/cases/compiler/tluaConstTypeParameters.tlua] ////

=== tluaConstTypeParameters.tlua ===
// A const type parameter types its argument as if the caller had written
// `as const`: literals stay narrow, table constructors freeze.

declare id: <const T>(x: T) => T;
>id : Symbol(id, Decl(tluaConstTypeParameters.tlua, 3, 7))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 3, 13))
>x : Symbol(x, Decl(tluaConstTypeParameters.tlua, 3, 22))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 3, 13))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 3, 13))

declare plain: <T>(x: T) => T;
>plain : Symbol(plain, Decl(tluaConstTypeParameters.tlua, 4, 7))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 4, 16))
>x : Symbol(x, Decl(tluaConstTypeParameters.tlua, 4, 19))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 4, 16))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 4, 16))

// Literals stay literal; the plain parameter widens as before.
local s = id("hi")
>s : Symbol(s, Decl(tluaConstTypeParameters.tlua, 7, 5))
>id : Symbol(id, Decl(tluaConstTypeParameters.tlua, 3, 7))

local n = id(42)
>n : Symbol(n, Decl(tluaConstTypeParameters.tlua, 8, 5))
>id : Symbol(id, Decl(tluaConstTypeParameters.tlua, 3, 7))

local sw = plain("hi")
>sw : Symbol(sw, Decl(tluaConstTypeParameters.tlua, 9, 5))
>plain : Symbol(plain, Decl(tluaConstTypeParameters.tlua, 4, 7))

// A table constructor in a bare const context freezes into a readonly record
// (tlua's record analog of TS's readonly tuple: `{...}` makes tuples only in
// real tuple contexts).
local rec = id({ x = 1, y = "a" })
>rec : Symbol(rec, Decl(tluaConstTypeParameters.tlua, 14, 5))
>id : Symbol(id, Decl(tluaConstTypeParameters.tlua, 3, 7))
>x : Symbol(x, Decl(tluaConstTypeParameters.tlua, 14, 16))
>y : Symbol(y, Decl(tluaConstTypeParameters.tlua, 14, 23))

local pos = id({ 1, 2 })
>pos : Symbol(pos, Decl(tluaConstTypeParameters.tlua, 15, 5))
>id : Symbol(id, Decl(tluaConstTypeParameters.tlua, 3, 7))

// Under an array constraint the constructor takes the tuple path. A mutable
// constraint strips readonly, exactly as upstream; a readonly constraint
// keeps it.
declare mut: <const T extends number[]>(x: T) => T;
>mut : Symbol(mut, Decl(tluaConstTypeParameters.tlua, 20, 7))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 20, 14))
>x : Symbol(x, Decl(tluaConstTypeParameters.tlua, 20, 40))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 20, 14))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 20, 14))

