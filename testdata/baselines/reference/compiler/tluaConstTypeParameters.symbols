>ro : Symbol(ro, Decl(tluaConstTypeParameters.tlua, 21, 7))

rt[1] = 5
>rt : Symbol(rt, Decl(tluaConstTypeParameters.tlua, 24, 5))
>1 : Symbol(1)

// The Zod-style shape from the array-context slice, now const: T infers the
// readonly tuple and T[number] is still the element union.
interface Schema<T> {
>Schema : Symbol(Schema, Decl(tluaConstTypeParameters.tlua, 25, 9))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 29, 17))

    parse(self: self, value: unknown): T;
>parse : Symbol(Schema.parse, Decl(tluaConstTypeParameters.tlua, 29, 21))
>self : Symbol(self, Decl(tluaConstTypeParameters.tlua, 30, 10))
>value : Symbol(value, Decl(tluaConstTypeParameters.tlua, 30, 21))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 29, 17))
}
type Infer<T> = T extends Schema<infer O> ? O : never;
>Infer : Symbol(Infer, Decl(tluaConstTypeParameters.tlua, 31, 1))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 32, 11))
>T : Symbol(T, Decl(tluaConstTypeParameters.tlua, 32, 11))
>Schema : Symbol(Schema, Decl(tluaConstTypeParameters.tlua, 25, 9))
>O : Symbol(O, Decl(tluaConstTypeParameters.tlua, 32, 38))
>O : Symbol(O, Decl(tluaConstTypeParameters.tlua, 32, 38))

