//// [tests/cases/compiler/tluaVarargNotPrefixExp.tlua] ////

=== tluaVarargNotPrefixExp.tlua ===
// In Lua `...` is not a prefixexp: it cannot be called, indexed, or
// member-accessed. Each of these is the prefixexp grammar error (TLUA100060)
// rather than quietly reading as a call/index/property access on the pack -- the
// TS spread forms `...(expr)` and `...expr` are gone, and must not sneak back in
// as suffixes. The emit parenthesizes the receiver, as Lua requires.
function f(...: number): void
>f : Symbol(f, Decl(tluaVarargNotPrefixExp.tlua, 0, 0))
> : Symbol((Missing), Decl(tluaVarargNotPrefixExp.tlua, 5, 11))

  local called = ...(1);
>called : Symbol(called, Decl(tluaVarargNotPrefixExp.tlua, 6, 7))

  local indexed = ...[1];
>indexed : Symbol(indexed, Decl(tluaVarargNotPrefixExp.tlua, 7, 7))

  local accessed = ....x;
>accessed : Symbol(accessed, Decl(tluaVarargNotPrefixExp.tlua, 8, 7))

  local method = ...:upper();
>method : Symbol(method, Decl(tluaVarargNotPrefixExp.tlua, 9, 7))

end

// The same holds in a table constructor, where TS table spread used to live.
function g(...: number): void
>g : Symbol(g, Decl(tluaVarargNotPrefixExp.tlua, 10, 3))
> : Symbol((Missing), Decl(tluaVarargNotPrefixExp.tlua, 13, 11))

  local t = { ...({} as number) };
>t : Symbol(t, Decl(tluaVarargNotPrefixExp.tlua, 14, 7))

end

// A bare `...` in each of those positions is still fine.
function h(...: number): void
>h : Symbol(h, Decl(tluaVarargNotPrefixExp.tlua, 15, 3))
> : Symbol((Missing), Decl(tluaVarargNotPrefixExp.tlua, 18, 11))

  local ok = ...;
>ok : Symbol(ok, Decl(tluaVarargNotPrefixExp.tlua, 19, 7))

  local t = { ... };
>t : Symbol(t, Decl(tluaVarargNotPrefixExp.tlua, 20, 7))

  f(...);
>f : Symbol(f, Decl(tluaVarargNotPrefixExp.tlua, 0, 0))

end

