//// [tests/cases/compiler/tluaTypeGuardIdentity.tlua] ////

=== tluaTypeGuardIdentity.tlua ===
// Only a call to the real global `type` or `io.type` (or a local alias of either,
// see tluaLocalBuiltinAlias) narrows. The binder admits a call spelled `type(x)`,
// `io.type(x)` or through a local alias name, and the checker turns down the
// ones that are not the builtin; the rest never become conditions. Each
// unnarrowed use below is an error.

declare v: string | number;
>v : string | number

declare function use(x: unknown): void;
>use : (x: unknown) => void
>x : unknown

function shadowed(): void
>shadowed : () => void

  local type = function(value: any) return "string"; end;
>type : (value: any) => string
>function(value: any) return "string"; end : (value: any) => string
>value : any
>"string" : "string"

  if type(v) == "string" then
>type(v) == "string" : boolean
>type(v) : string
>type : (value: any) => string
>v : string | number
>"string" : "string"

    local s: string = v;
>s : string
>v : string | number

  end
end

declare holder: { type: (value: any) => string };
>holder : { type: (value: any) => string; }
>type : (value: any) => string
>value : any

function member(): void
>member : () => void

  if holder.type(v) == "string" then
>holder.type(v) == "string" : boolean
>holder.type(v) : string
>holder.type : (value: any) => string
>holder : { type: (value: any) => string; }
>type : (value: any) => string
>v : string | number
>"string" : "string"

    local s: string = v;
>s : string
>v : string | number

  end
end

function shadowedIo(): void
>shadowedIo : () => void

  local io = { type = function(value: any): string return "file" end }
>io : { type: (value: any) => string; }
>{ type = function(value: any): string return "file" end } : { type: (value: any) => string; }
>type : (value: any) => string
>function(value: any): string return "file" end : (value: any) => string
>value : any
>"file" : "file"

  if io.type(v) == "string" then
>io.type(v) == "string" : boolean
>io.type(v) : string
>io.type : (value: any) => string
>io : { type: (value: any) => string; }
>type : (value: any) => string
>v : string | number
>"string" : "string"

    local s: string = v;
>s : string
>v : string | number

  end
end

// A colon call passes io itself as the first argument, so it tests io, not v.
function colonIo(): void
>colonIo : () => void

  if io:type(v) == "file" then
>io:type(v) == "file" : boolean
>io:type(v) : "closed file" | "file" | nil
>io:type : (value: any) => "file" | "closed file" | nil
>io : IOLib
>type : (value: any) => "file" | "closed file" | nil
>v : string | number
>"file" : "file"

    local s: string = v;
>s : string
>v : string | number

  end
end

function wrongArity(): void
>wrongArity : () => void

  if type() == "string" then
>type() == "string" : boolean
>type() : "boolean" | "cdata" | "function" | "nil" | "number" | "string" | "table" | "thread" | "userdata"
>type : (value: any) => "nil" | "number" | "string" | "boolean" | "table" | "function" | "thread" | "userdata" | "cdata"
>"string" : "string"

    local s: string = v;
>s : string
>v : string | number

  end
end

// The global still narrows in the same file, once the shadow is out of scope.
function global(): void
>global : () => void

  if type(v) == "string" then
>type(v) == "string" : boolean
>type(v) : "boolean" | "cdata" | "function" | "nil" | "number" | "string" | "table" | "thread" | "userdata"
>type : (value: any) => "nil" | "number" | "string" | "boolean" | "table" | "function" | "thread" | "userdata" | "cdata"
>v : string | number
>"string" : "string"

    local s: string = v;
>s : string
>v : string

    use(s);
>use(s) : void
>use : (x: unknown) => void
>s : string

  end
end

