// A surplus guard has no positional target and remains an ordinary read.
DiscardedGuard = {}, DiscardedGuard or {};
>DiscardedGuard = {}, DiscardedGuard or {} : {}
>DiscardedGuard : {}
>{}, DiscardedGuard or {} : {}, {}
>{} : {}
>DiscardedGuard or {} : {}
>DiscardedGuard : {}
