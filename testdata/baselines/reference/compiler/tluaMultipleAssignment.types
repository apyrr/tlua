// Extra and missing values follow Lua's adjustment rules.
local optional: string | nil = "";
>optional : string | nil
>"" : ""

optional, count = "present";
>optional, count = "present" : "present"
>optional, count : string | nil, number
>optional : string | nil
>count : number
>"present" : "present"

// Each target is checked against its positional value.
count, label = "wrong", 3;
>count, label = "wrong", 3 : string
>count, label : number, string
>count : number
>label : string
>"wrong", 3 : string, number
>"wrong" : "wrong"
>3 : 3

