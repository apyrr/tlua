//// [tests/cases/compiler/tluaHexFloats.tlua] ////

=== tluaHexFloats.tlua ===
// Lua hexadecimal numerals carry an optional fraction and binary exponent:
// 0xA.8p1 is (10 + 8/16) * 2^1.

local exponent: 16 = 0x1p4
>exponent : Symbol(exponent, Decl(tluaHexFloats.tlua, 3, 5))

local both: 21 = 0xA.8p1
>both : Symbol(both, Decl(tluaHexFloats.tlua, 4, 5))

local fraction: 0.5 = 0x.8
>fraction : Symbol(fraction, Decl(tluaHexFloats.tlua, 5, 5))

local negative: 0.25 = 0x1P-2
>negative : Symbol(negative, Decl(tluaHexFloats.tlua, 6, 5))

local positive: 4 = 0x1p+2
>positive : Symbol(positive, Decl(tluaHexFloats.tlua, 7, 5))

local trailingDot: 1 = 0x1.
>trailingDot : Symbol(trailingDot, Decl(tluaHexFloats.tlua, 8, 5))

local integer: 255 = 0xff
>integer : Symbol(integer, Decl(tluaHexFloats.tlua, 9, 5))

local concat = 0x10 .. "a"
>concat : Symbol(concat, Decl(tluaHexFloats.tlua, 10, 5))

local tightConcat = 0x10.."a"
>tightConcat : Symbol(tightConcat, Decl(tluaHexFloats.tlua, 11, 5))

-- An identifier cannot follow a hexadecimal literal, integer or float.
local afterInteger = 0x1g
>afterInteger : Symbol(afterInteger, Decl(tluaHexFloats.tlua, 13, 5))

local afterFloat = 0x1.8g
>afterFloat : Symbol(afterFloat, Decl(tluaHexFloats.tlua, 14, 5))

local afterLeadingZero = 012g
>afterLeadingZero : Symbol(afterLeadingZero, Decl(tluaHexFloats.tlua, 15, 5))

-- A binary exponent is exponent notation, not a digit run too long to be exact.
local large = 0x1p60
>large : Symbol(large, Decl(tluaHexFloats.tlua, 17, 5))

-- A binary exponent needs digits.
local missing = 0x1p
>missing : Symbol(missing, Decl(tluaHexFloats.tlua, 20, 5))

