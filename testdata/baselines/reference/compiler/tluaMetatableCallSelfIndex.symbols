>self : Symbol(self, Decl(tluaMetatableCallSelfIndex.tlua, 12, 18))
>Transaction : Symbol(Transaction, Decl(tluaMetatableCallSelfIndex.tlua, 0, 0))
>sql : Symbol(sql, Decl(tluaMetatableCallSelfIndex.tlua, 12, 36))

  return {};
end

