//// [tests/cases/compiler/tluaStringDecimalEscapeRange.tlua] ////

=== tluaStringDecimalEscapeRange.tlua ===
// Lua's decimal escape names one byte, so it cannot exceed 255.
local ok = "\255"
>ok : Symbol(ok, Decl(tluaStringDecimalEscapeRange.tlua, 1, 5))

local tooLarge = "\256"
>tooLarge : Symbol(tooLarge, Decl(tluaStringDecimalEscapeRange.tlua, 2, 5))

