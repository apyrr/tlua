//// [tests/cases/compiler/tableConstructorArrayContextInference.tlua] ////

=== tableConstructorArrayContextInference.tlua ===
interface Schema<T> {
    parse(self: self, value: unknown): T;
>parse : (self: self, value: unknown) => T
>self : self
>value : unknown
}

interface ObjectSchema<T> extends Schema<T> {}

type Infer<T> = T extends Schema<infer O> ? O : never;
>Infer : Infer<T>

type InferUnion<T extends Schema<unknown>[]> = Infer<T[number]>;
>InferUnion : InferUnion<T>

declare object: <T extends table>() => ObjectSchema<T>;
>object : <T extends table>() => ObjectSchema<T>

declare union: <T extends Schema<unknown>[]>(options: T) => Schema<InferUnion<T>>;
>union : <T extends Schema<unknown>[]>(options: T) => Schema<InferUnion<T>>
>options : T

local success = object<{
>success : ObjectSchema<{ status: "success"; data: string; }>
>object<{    status: "success";    data: string;}>() : ObjectSchema<{ status: "success"; data: string; }>
>object : <T extends table>() => ObjectSchema<T>

    status: "success";
>status : "success"

    data: string;
>data : string

}>()

local failed = object<{
>failed : ObjectSchema<{ status: "failed"; error: string; }>
>object<{    status: "failed";    error: string;}>() : ObjectSchema<{ status: "failed"; error: string; }>
>object : <T extends table>() => ObjectSchema<T>

    status: "failed";
>status : "failed"

    error: string;
>error : string

}>()

-- A table constructor in an array context types as an array, so the inferred
-- `T` has a number index signature and `T[number]` is the element union. Typed
-- as a number-keyed record instead, the read would find no applicable index
-- info and silently resolve to `unknown`.
local result = union({ success, failed }):parse({})
>result : { status: "success"; data: string; } | { status: "failed"; error: string; }
>union({ success, failed }):parse({}) : { status: "success"; data: string; } | { status: "failed"; error: string; }
>union({ success, failed }):parse : (self: Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>, value: unknown) => { status: "success"; data: string; } | { status: "failed"; error: string; }
>union({ success, failed }) : Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>
>union : <T extends Schema<unknown>[]>(options: T) => Schema<InferUnion<T>>
>{ success, failed } : (ObjectSchema<{ status: "success"; data: string; }> | ObjectSchema<{ status: "failed"; error: string; }>)[]
>success : error
>failed : error
>parse : (self: Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>, value: unknown) => { status: "success"; data: string; } | { status: "failed"; error: string; }
>{} : {}

local s = result.status
>s : "failed" | "success"
>result.status : "failed" | "success"
>result : { status: "success"; data: string; } | { status: "failed"; error: string; }
>status : "failed" | "success"

-- control cases from the report
type A = Infer<typeof success>;
>A : { status: "success"; data: string; }
>success : ObjectSchema<{ status: "success"; data: string; }>

local annotated: (typeof success | typeof failed)[] = { success, failed }
>annotated : (ObjectSchema<{ status: "success"; data: string; }> | ObjectSchema<{ status: "failed"; error: string; }>)[]
>success : ObjectSchema<{ status: "success"; data: string; }>
>failed : ObjectSchema<{ status: "failed"; error: string; }>
>{ success, failed } : (ObjectSchema<{ status: "success"; data: string; }> | ObjectSchema<{ status: "failed"; error: string; }>)[]
>success : error
>failed : error

local result2 = union(annotated):parse({})
>result2 : { status: "success"; data: string; } | { status: "failed"; error: string; }
>union(annotated):parse({}) : { status: "success"; data: string; } | { status: "failed"; error: string; }
>union(annotated):parse : (self: Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>, value: unknown) => { status: "success"; data: string; } | { status: "failed"; error: string; }
>union(annotated) : Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>
>union : <T extends Schema<unknown>[]>(options: T) => Schema<InferUnion<T>>
>annotated : (ObjectSchema<{ status: "success"; data: string; }> | ObjectSchema<{ status: "failed"; error: string; }>)[]
>parse : (self: Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>, value: unknown) => { status: "success"; data: string; } | { status: "failed"; error: string; }
>{} : {}

local s2 = result2.status
>s2 : "failed" | "success"
>result2.status : "failed" | "success"
>result2 : { status: "success"; data: string; } | { status: "failed"; error: string; }
>status : "failed" | "success"

-- An empty constructor is vacuously all-positional, so it takes the array path
-- and its element type is never.
local empty: number[] = {}
>empty : number[]
>{} : never[]

local emptyInferred = union({})
>emptyInferred : Schema<never>
>union({}) : Schema<never>
>union : <T extends Schema<unknown>[]>(options: T) => Schema<InferUnion<T>>
>{} : never[]

-- The last entry expands its pack: an array has no positional slots, so every
-- value the pack can produce joins the element union.
declare function two(): (string, string);
>two : () => (string, string)

local packed: string[] = { two() }
>packed : string[]
>{ two() } : string[]
>two() : string
>two : () => (string, string)

function collect(...: string): string[]
>collect : (...: string) => string[]
> : string[]

    return {...};
>{...} : string[]
>... : string | nil

end

declare function pair(): (typeof success, typeof failed);
>pair : () => (ObjectSchema<{ status: "success"; data: string; }>, ObjectSchema<{ status: "failed"; error: string; }>)
>success : ObjectSchema<{ status: "success"; data: string; }>
>failed : ObjectSchema<{ status: "failed"; error: string; }>

local packInferred = union({ pair() }):parse({})
>packInferred : { status: "success"; data: string; } | { status: "failed"; error: string; }
>union({ pair() }):parse({}) : { status: "success"; data: string; } | { status: "failed"; error: string; }
>union({ pair() }):parse : (self: Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>, value: unknown) => { status: "success"; data: string; } | { status: "failed"; error: string; }
>union({ pair() }) : Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>
>union : <T extends Schema<unknown>[]>(options: T) => Schema<InferUnion<T>>
>{ pair() } : (ObjectSchema<{ status: "success"; data: string; }> | ObjectSchema<{ status: "failed"; error: string; }>)[]
>pair() : ObjectSchema<{ status: "success"; data: string; }>
>pair : () => (ObjectSchema<{ status: "success"; data: string; }>, ObjectSchema<{ status: "failed"; error: string; }>)
>parse : (self: Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>, value: unknown) => { status: "success"; data: string; } | { status: "failed"; error: string; }
>{} : {}

local packStatus = packInferred.status
>packStatus : "failed" | "success"
>packInferred.status : "failed" | "success"
>packInferred : { status: "success"; data: string; } | { status: "failed"; error: string; }
>status : "failed" | "success"

-- A readonly array context takes the arm too; the mutable result is assignable.
local ro: readonly number[] = { 1, 2 }
>ro : readonly number[]
>{ 1, 2 } : number[]

-- Known non-goal: a `Table<number, V>`-shaped context keeps the object path.
-- The number-keyed record already satisfies it relationally, and inference
-- reaches the value type through inferFromIndexTypes rather than `T[number]`.
declare function collectTable<T extends Table<number, string>>(t: T): T;
>collectTable : <T extends Table<number, string>>(t: T) => T
>t : T

local tabled = collectTable({ "a", "b" })
>tabled : { 1: string; 2: string; }
>collectTable({ "a", "b" }) : { 1: string; 2: string; }
>collectTable : <T extends Table<number, string>>(t: T) => T
>{ "a", "b" } : { 1: string; 2: string; }

local tabledValue: string = tabled[1]
>tabledValue : string
>tabled[1] : string
>tabled : { 1: string; 2: string; }
>1 : 1

-- An OPTIONAL array context (`X[] | nil`) takes the arm through its array
-- constituent: nil is not a numeric-keyed record, so the exclusion does not
-- block, and a literal constructor is self-evidently not nil.
local opt: number[] | nil = { 1, 2 }
>opt : number[] | nil
>{ 1, 2 } : number[]

declare unionOpt: <T extends Schema<unknown>[]>(options: T | nil) => Schema<InferUnion<T>>;
>unionOpt : <T extends Schema<unknown>[]>(options: T | nil) => Schema<InferUnion<T>>
>options : T | nil

local viaOpt = unionOpt({ success, failed }):parse({})
>viaOpt : { status: "success"; data: string; } | { status: "failed"; error: string; }
>unionOpt({ success, failed }):parse({}) : { status: "success"; data: string; } | { status: "failed"; error: string; }
>unionOpt({ success, failed }):parse : (self: Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>, value: unknown) => { status: "success"; data: string; } | { status: "failed"; error: string; }
>unionOpt({ success, failed }) : Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>
>unionOpt : <T extends Schema<unknown>[]>(options: T | nil) => Schema<InferUnion<T>>
>{ success, failed } : (ObjectSchema<{ status: "success"; data: string; }> | ObjectSchema<{ status: "failed"; error: string; }>)[]
>success : error
>failed : error
>parse : (self: Schema<{ status: "success"; data: string; } | { status: "failed"; error: string; }>, value: unknown) => { status: "success"; data: string; } | { status: "failed"; error: string; }
>{} : {}

local optStatus = viaOpt.status
>optStatus : "failed" | "success"
>viaOpt.status : "failed" | "success"
>viaOpt : { status: "success"; data: string; } | { status: "failed"; error: string; }
>status : "failed" | "success"

