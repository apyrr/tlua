// `a and a:m()` keeps one value: Lua's `and` yields a single result, so an
// optional colon call of a multi-value method yields its first value (or nil).
interface Pair {
>Pair : Symbol(Pair, Decl(tluaOptionalColonCall.tlua, 50, 31))

    pair(self: Pair): (number, string);
>pair : Symbol(Pair.pair, Decl(tluaOptionalColonCall.tlua, 54, 16))
>self : Symbol(self, Decl(tluaOptionalColonCall.tlua, 55, 9))
>Pair : Symbol(Pair, Decl(tluaOptionalColonCall.tlua, 50, 31))
}
