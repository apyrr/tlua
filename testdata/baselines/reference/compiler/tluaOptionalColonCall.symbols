=== tluaOptionalColonCall.tlua ===
// `obj?:m(args)` is the optional colon call: `obj and obj:m(args)`. The receiver
// is passed non-nil, since the call only happens when it is not nil, and the
// result gains `nil` like any other optional chain.

interface Box {
>Box : Symbol(Box, Decl(tluaOptionalColonCall.tlua, 0, 0))

    value: number;
>value : Symbol(Box.value, Decl(tluaOptionalColonCall.tlua, 4, 15))

    inner: Box | nil;
>inner : Symbol(Box.inner, Decl(tluaOptionalColonCall.tlua, 5, 18))
>Box : Symbol(Box, Decl(tluaOptionalColonCall.tlua, 0, 0))

    read(self: Box): number;
>read : Symbol(Box.read, Decl(tluaOptionalColonCall.tlua, 6, 21))
>self : Symbol(self, Decl(tluaOptionalColonCall.tlua, 7, 9))
>Box : Symbol(Box, Decl(tluaOptionalColonCall.tlua, 0, 0))

    set(self: Box, v: number): nil;
>set : Symbol(Box.set, Decl(tluaOptionalColonCall.tlua, 7, 28))
>self : Symbol(self, Decl(tluaOptionalColonCall.tlua, 8, 8))
>Box : Symbol(Box, Decl(tluaOptionalColonCall.tlua, 0, 0))
>v : Symbol(v, Decl(tluaOptionalColonCall.tlua, 8, 18))
}

declare function maybeBox(): Box | nil;
