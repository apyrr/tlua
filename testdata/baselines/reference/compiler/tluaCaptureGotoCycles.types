//// [tests/cases/compiler/tluaCaptureGotoCycles.tlua] ////

=== tluaCaptureGotoCycles.tlua ===
// A backward goto re-runs everything between its label and itself, so an assignment inside that
// span poisons capture narrowing to the goto's end -- the same rule a while body already gets.
// Without it, a closure created after the nil guard could be called on the next pass, after the
// reassignment and before the guard, and hand out the nil the narrowing promised away.

declare function maybeName(): string | nil;
>maybeName : () => string | nil

declare function cond(): boolean;
>cond : () => boolean

// A function declaration created inside the cycle reads the declared type.
function declarationInCycle(): void
>declarationInCycle : () => void

  local name = maybeName();
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  local saved: (() => string) | nil = nil;
>saved : (() => string) | nil

  ::top::
>top : any

  name = maybeName();
>name = maybeName() : string | nil
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  if saved ~= nil then
>saved ~= nil : boolean
>saved : (() => string) | nil

    local s: string = saved();
>s : string
>saved() : string
>saved : () => string

  end
  if name == nil then
>name == nil : boolean
>name : string | nil

    name = "anon";
>name = "anon" : "anon"
>name : string | nil
>"anon" : "anon"

  end
  function greet(): string
>greet : () => string

    return name;              // error: the goto re-opens the nil arm
>name : string | nil

  end
  saved = greet;
>saved = greet : () => string
>saved : (() => string) | nil
>greet : () => string

  if cond() then
>cond() : boolean
>cond : () => boolean

    goto top;
>top : any

  end
end

// A function expression gets the same suppression.
function expressionInCycle(): void
>expressionInCycle : () => void

  local name = maybeName();
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  local saved: (() => string) | nil = nil;
>saved : (() => string) | nil

  ::top::
>top : any

  name = maybeName();
>name = maybeName() : string | nil
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  if saved ~= nil then
>saved ~= nil : boolean
>saved : (() => string) | nil

    local s: string = saved();
>s : string
>saved() : string
>saved : () => string

  end
  if name == nil then
>name == nil : boolean
>name : string | nil

    name = "anon";
>name = "anon" : "anon"
>name : string | nil
>"anon" : "anon"

  end
  saved = function(): string
>saved = function(): string    return name;              // error: same cycle, same rule  end : () => string
>saved : (() => string) | nil
>function(): string    return name;              // error: same cycle, same rule  end : () => string

    return name;              // error: same cycle, same rule
>name : string | nil

  end;
  if cond() then
>cond() : boolean
>cond : () => boolean

    goto top;
>top : any

  end
end

// The syntactic loop keeps its own, older extension.
function whileLoop(): void
>whileLoop : () => void

  local name = maybeName();
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  local saved: (() => string) | nil = nil;
>saved : (() => string) | nil

  while cond() do
>cond() : boolean
>cond : () => boolean

    name = maybeName();
>name = maybeName() : string | nil
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

    if name == nil then
>name == nil : boolean
>name : string | nil

      name = "anon";
>name = "anon" : "anon"
>name : string | nil
>"anon" : "anon"

    end
    saved = function(): string
>saved = function(): string      return name;            // error: the loop body extension    end : () => string
>saved : (() => string) | nil
>function(): string      return name;            // error: the loop body extension    end : () => string

      return name;            // error: the loop body extension
>name : string | nil

    end;
  end
end

// A local declared inside the cycle is a fresh binding on every pass: the one a closure
// captured is never assigned again, so its narrowing stands.
function freshBindingInCycle(): void
>freshBindingInCycle : () => void

  local saved: (() => string) | nil = nil;
>saved : (() => string) | nil

  ::top::
>top : any

  local name = maybeName();
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  if saved ~= nil then
>saved ~= nil : boolean
>saved : (() => string) | nil

    local s: string = saved();
>s : string
>saved() : string
>saved : () => string

  end
  if name == nil then
>name == nil : boolean
>name : string | nil

    name = "anon";
>name = "anon" : "anon"
>name : string | nil
>"anon" : "anon"

  end
  saved = function(): string
>saved = function(): string    return name;              // fine: this pass's binding is done being assigned  end : () => string
>saved : (() => string) | nil
>function(): string    return name;              // fine: this pass's binding is done being assigned  end : () => string

    return name;              // fine: this pass's binding is done being assigned
>name : string

  end;
  if cond() then
>cond() : boolean
>cond : () => boolean

    goto top;
>top : any

  end
end

// A forward goto re-enters nothing, so it suppresses nothing.
function forwardOnly(): void
>forwardOnly : () => void

  local name = maybeName();
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  if cond() then
>cond() : boolean
>cond : () => boolean

    goto done;
>done : any

  end
  if name == nil then
>name == nil : boolean
>name : string | nil

    name = "anon";
>name = "anon" : "anon"
>name : string | nil
>"anon" : "anon"

  end
  function g(): string
>g : () => string

    return name;              // fine: only reachable through the guard
>name : string

  end
  ::done::
>done : any

end

// A same-named label in a block the goto cannot see does not stand in for the real target:
// the goto resolves to the outer ::top::, whose cycle re-runs the assignment.
function shadowedLabel(): void
>shadowedLabel : () => void

  if cond() then
>cond() : boolean
>cond : () => boolean

    ::top::                  // scoped to this then-block; invisible to the goto below
>top : any

  end
  local name = maybeName();
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  local saved: (() => string) | nil = nil;
>saved : (() => string) | nil

  ::top::
>top : any

  name = maybeName();
>name = maybeName() : string | nil
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  if saved ~= nil then
>saved ~= nil : boolean
>saved : (() => string) | nil

    local s: string = saved();
>s : string
>saved() : string
>saved : () => string

  end
  if name == nil then
>name == nil : boolean
>name : string | nil

    name = "anon";
>name = "anon" : "anon"
>name : string | nil
>"anon" : "anon"

  end
  saved = function(): string
>saved = function(): string    return name;             // error: the outer label's cycle re-opens the nil arm  end : () => string
>saved : (() => string) | nil
>function(): string    return name;             // error: the outer label's cycle re-opens the nil arm  end : () => string

    return name;             // error: the outer label's cycle re-opens the nil arm
>name : string | nil

  end;
  if cond() then
>cond() : boolean
>cond : () => boolean

    goto top;
>top : any

  end
end

// Assignments wholly before the label are not re-run by the jump.
function beforeLabel(): void
>beforeLabel : () => void

  local name = maybeName();
>name : string | nil
>maybeName() : string | nil
>maybeName : () => string | nil

  if name == nil then
>name == nil : boolean
>name : string | nil

    name = "anon";
>name = "anon" : "anon"
>name : string | nil
>"anon" : "anon"

  end
  local saved: (() => string) | nil = nil;
>saved : (() => string) | nil

  ::top::
>top : any

  saved = function(): string
>saved = function(): string    return name;              // fine: the cycle never assigns name  end : () => string
>saved : (() => string) | nil
>function(): string    return name;              // fine: the cycle never assigns name  end : () => string

    return name;              // fine: the cycle never assigns name
>name : string

  end;
  if cond() then
>cond() : boolean
>cond : () => boolean

    goto top;
>top : any

  end
end

