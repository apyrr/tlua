// An erased assertion refines the first result of a generic pack without
// prefixing a new value or discarding the producer's remaining results.
function projectFirst<...A>(f: () => (...A))
>projectFirst : <...A>(f: () => (...A)) => ((number | nil)?, ...A[number])
>f : () => (...A)

    return f() as number;
>f() as number : number
>f() : A[number] | nil
>f : () => (...A)

end

local projected = projectFirst(function()
>projected : number | nil
>projectFirst(function()    return "runtime";end) : number | nil
>projectFirst : <...A>(f: () => (...A)) => ((number | nil)?, ...A[number])
>function()    return "runtime";end : () => string

    return "runtime";
>"runtime" : "runtime"

end);
local projectedFirst: number | nil = projected;
>projectedFirst : number | nil
>projected : number | nil

local first, second = projectFirst(function()
>first : number | nil
>second : string | boolean | nil
>projectFirst(function()    return "runtime", true;end) : number | nil
>projectFirst : <...A>(f: () => (...A)) => ((number | nil)?, ...A[number])
>function()    return "runtime", true;end : () => (string, boolean)

    return "runtime", true;
>"runtime", true : string, true
>"runtime" : "runtime"
>true : true

end);
