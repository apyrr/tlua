declare function acceptsProjected(first: number | nil, ...: any[]): void;
>acceptsProjected : (first: number | nil, ...: any[]) => void
>first : number | nil
> : any[][]

function forwardProjected<...A>(f: () => (...A))
>forwardProjected : <...A>(f: () => (...A)) => void
>f : () => (...A)

    acceptsProjected(f() as number);
>acceptsProjected(f() as number) : void
>acceptsProjected : (first: number | nil, ...: any[]) => void
>f() as number : number
>f() : A[number] | nil
>f : () => (...A)

end

// Parentheses collapse the asserted generic pack to one value, but its first
// slot remains optional because the source pack may be empty.
function parenthesizedProjectFirst<...A>(f: () => (...A))
>parenthesizedProjectFirst : <...A>(f: () => (...A)) => number | nil
>f : () => (...A)

    return (f() as number);
>(f() as number) : number | nil
>f() as number : number
>f() : A[number] | nil
>f : () => (...A)

end

local parenthesizedProjected = parenthesizedProjectFirst(function(): void end);
>parenthesizedProjected : number | nil
>parenthesizedProjectFirst(function(): void end) : number | nil
>parenthesizedProjectFirst : <...A>(f: () => (...A)) => number | nil
>function(): void end : () => void

