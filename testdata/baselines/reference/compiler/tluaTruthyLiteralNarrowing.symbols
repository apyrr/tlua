//// [tests/cases/compiler/tluaTruthyLiteralNarrowing.tlua] ////

=== tluaTruthyLiteralNarrowing.tlua ===
// Lua treats only nil and false as falsy, so a string, number, table or function
// literal is always truthy. In `c and <literal> or y` that makes `y` reachable only
// when `c` is falsy, which is what lets Lua's ternary idiom narrow.

type U = { op: "a"; name: string } | { op: "b" }
>U : Symbol(U, Decl(tluaTruthyLiteralNarrowing.tlua, 0, 0))
>op : Symbol(op, Decl(tluaTruthyLiteralNarrowing.tlua, 4, 10))
>name : Symbol(name, Decl(tluaTruthyLiteralNarrowing.tlua, 4, 19))
>op : Symbol(op, Decl(tluaTruthyLiteralNarrowing.tlua, 4, 38))

declare function getU(): U;
>getU : Symbol(getU, Decl(tluaTruthyLiteralNarrowing.tlua, 4, 48))
>U : Symbol(U, Decl(tluaTruthyLiteralNarrowing.tlua, 0, 0))

local u = getU()
>u : Symbol(u, Decl(tluaTruthyLiteralNarrowing.tlua, 8, 5))
>getU : Symbol(getU, Decl(tluaTruthyLiteralNarrowing.tlua, 4, 48))

local s: string = u.op == "b" and "b" or u.name
>s : Symbol(s, Decl(tluaTruthyLiteralNarrowing.tlua, 9, 5))
