// `nil` and `false` are the falsy side: the true branch of `c and nil` is never
// taken, so the assignment inside it never reaches the read below.
local v: string | number = "s"
>v : Symbol(v, Decl(tluaTruthyLiteralNarrowing.tlua, 21, 5))

if u.op == "b" and nil then
>u.op : Symbol(op, Decl(tluaTruthyLiteralNarrowing.tlua, 4, 10), Decl(tluaTruthyLiteralNarrowing.tlua, 4, 38))
>u : Symbol(u, Decl(tluaTruthyLiteralNarrowing.tlua, 8, 5))
>op : Symbol(op, Decl(tluaTruthyLiteralNarrowing.tlua, 4, 10), Decl(tluaTruthyLiteralNarrowing.tlua, 4, 38))

    v = 1
>v : Symbol(v, Decl(tluaTruthyLiteralNarrowing.tlua, 21, 5))

end
local onlyString: string = v
>onlyString : Symbol(onlyString, Decl(tluaTruthyLiteralNarrowing.tlua, 25, 5))
>v : Symbol(v, Decl(tluaTruthyLiteralNarrowing.tlua, 21, 5))

// A template string is always a Lua string, so it is always truthy.
declare function label(): string;
>label : Symbol(label, Decl(tluaTruthyLiteralNarrowing.tlua, 25, 28))

if `${label()}` then
>label : Symbol(label, Decl(tluaTruthyLiteralNarrowing.tlua, 25, 28))

end

// A middle operand that may be falsy does not narrow.
declare function maybeName(): string | nil;
>maybeName : Symbol(maybeName, Decl(tluaTruthyLiteralNarrowing.tlua, 30, 3))

local bad: string | nil = u.op == "b" and maybeName() or u.name
>bad : Symbol(bad, Decl(tluaTruthyLiteralNarrowing.tlua, 34, 5))
