// Only a void assertion must be analyzable to be called: one that returns values
// is still an ordinary call through a table, an element access or _G -- it just
// does not narrow there.
declare maybe: string | nil
>maybe : Symbol(maybe, Decl(tluaAssertsWithReturn.tlua, 59, 7))

local M = { assert = assert }
>M : Symbol(M, Decl(tluaAssertsWithReturn.tlua, 60, 5))
>assert : Symbol(assert, Decl(tluaAssertsWithReturn.tlua, 60, 11))
>assert : Symbol(assert, Decl(lib.luajit.d.tlua, --, --))

M.assert(maybe)
>M.assert : Symbol(assert, Decl(tluaAssertsWithReturn.tlua, 60, 11))
>M : Symbol(M, Decl(tluaAssertsWithReturn.tlua, 60, 5))
>assert : Symbol(assert, Decl(tluaAssertsWithReturn.tlua, 60, 11))
>maybe : Symbol(maybe, Decl(tluaAssertsWithReturn.tlua, 59, 7))

local fns = { assert }
>fns : Symbol(fns, Decl(tluaAssertsWithReturn.tlua, 62, 5))

fns[1](maybe)
>fns : Symbol(fns, Decl(tluaAssertsWithReturn.tlua, 62, 5))
>1 : Symbol(1, Decl(tluaAssertsWithReturn.tlua, 62, 13))
>maybe : Symbol(maybe, Decl(tluaAssertsWithReturn.tlua, 59, 7))

_G.assert(maybe)
>_G.assert : Symbol(assert, Decl(lib.luajit.d.tlua, --, --))
>_G : Symbol(_G)
>assert : Symbol(assert, Decl(lib.luajit.d.tlua, --, --))
>maybe : Symbol(maybe, Decl(tluaAssertsWithReturn.tlua, 59, 7))

