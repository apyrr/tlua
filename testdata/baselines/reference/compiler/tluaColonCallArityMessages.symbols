//// [tests/cases/compiler/tluaColonCallArityMessages.tlua] ////

=== tluaColonCallArityMessages.tlua ===
// A colon call passes its receiver as the implicit first argument, so the
// effective argument list the checker matches against the signature is one
// longer than the source. An arity message counts what was WRITTEN, or it
// describes an argument list the reader cannot see: `text:upper(1)` takes no
// written arguments at all, so "expected 1, got 2" names neither the slot the
// user can fill nor the argument they typed.

local text: string = "hello";
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))

text:upper(1);
>text:upper : Symbol(String.upper, Decl(lib.luajit.d.tlua, --, --))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))
>upper : Symbol(String.upper, Decl(lib.luajit.d.tlua, --, --))

text:len(1, 2);
>text:len : Symbol(String.len, Decl(lib.luajit.d.tlua, --, --))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))
>len : Symbol(String.len, Decl(lib.luajit.d.tlua, --, --))

// Too few, measured the same way: `sub` takes `self` plus a start index.
text:sub();
>text:sub : Symbol(String.sub, Decl(lib.luajit.d.tlua, --, --))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))
>sub : Symbol(String.sub, Decl(lib.luajit.d.tlua, --, --))

// The dot form writes its receiver, so counting it is correct there -- these
// messages must NOT shift.
text.upper();
>text.upper : Symbol(String.upper, Decl(lib.luajit.d.tlua, --, --))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))
>upper : Symbol(String.upper, Decl(lib.luajit.d.tlua, --, --))

text.sub(text);
>text.sub : Symbol(String.sub, Decl(lib.luajit.d.tlua, --, --))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))
>sub : Symbol(String.sub, Decl(lib.luajit.d.tlua, --, --))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))

// The namespace form never had a receiver to hide.
local nsPiece: string = string.sub(text, 1, 5);
>nsPiece : Symbol(nsPiece, Decl(tluaColonCallArityMessages.tlua, 21, 5))
>string.sub : Symbol(StringLib.sub, Decl(lib.luajit.d.tlua, --, --))
>string : Symbol(string, Decl(lib.luajit.d.tlua, --, --))
>sub : Symbol(StringLib.sub, Decl(lib.luajit.d.tlua, --, --))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))

string.sub(text);
>string.sub : Symbol(StringLib.sub, Decl(lib.luajit.d.tlua, --, --))
>string : Symbol(string, Decl(lib.luajit.d.tlua, --, --))
>sub : Symbol(StringLib.sub, Decl(lib.luajit.d.tlua, --, --))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))

declare buffer: LuaStringBuffer;
>buffer : Symbol(buffer, Decl(tluaColonCallArityMessages.tlua, 24, 7))
>LuaStringBuffer : Symbol(LuaStringBuffer, Decl(lib.luajit.d.tlua, --, --))

// A rest parameter reports a minimum, and the receiver comes out of that too.
buffer:put();
>buffer:put : Symbol(LuaStringBuffer.put, Decl(lib.luajit.d.tlua, --, --))
>buffer : Symbol(buffer, Decl(tluaColonCallArityMessages.tlua, 24, 7))
>put : Symbol(LuaStringBuffer.put, Decl(lib.luajit.d.tlua, --, --))

buffer.put(buffer);
>buffer.put : Symbol(LuaStringBuffer.put, Decl(lib.luajit.d.tlua, --, --))
>buffer : Symbol(buffer, Decl(tluaColonCallArityMessages.tlua, 24, 7))
>put : Symbol(LuaStringBuffer.put, Decl(lib.luajit.d.tlua, --, --))
>buffer : Symbol(buffer, Decl(tluaColonCallArityMessages.tlua, 24, 7))

// string.format checks arity against the format string's specifiers, on its
// own path -- the receiver has to come out of both counts there as well.
("%d"):format(1, 2);
>("%d"):format : Symbol(String.format, Decl(lib.luajit.d.tlua, --, --))
>format : Symbol(String.format, Decl(lib.luajit.d.tlua, --, --))

("%d"):format();
>("%d"):format : Symbol(String.format, Decl(lib.luajit.d.tlua, --, --))
>format : Symbol(String.format, Decl(lib.luajit.d.tlua, --, --))

string.format("%d", 1, 2);
>string.format : Symbol(StringLib.format, Decl(lib.luajit.d.tlua, --, --))
>string : Symbol(string, Decl(lib.luajit.d.tlua, --, --))
>format : Symbol(StringLib.format, Decl(lib.luajit.d.tlua, --, --))

// The overload branch: no candidate matches, so the message lists the counts the
// candidates DO accept. Those are written counts too, and a candidate with no
// parameter for the receiver to fill cannot be described that way at all -- the
// message then reports the mismatch in the terms it happened in rather than
// collapsing distinct counts into "no overload expects 0 ... expects either 0".
interface String {
>String : Symbol(String, Decl(lib.luajit.d.tlua, --, --), Decl(tluaColonCallArityMessages.tlua, 33, 26))

  overloaded(): string;
>overloaded : Symbol(String.overloaded, Decl(tluaColonCallArityMessages.tlua, 40, 18), Decl(tluaColonCallArityMessages.tlua, 41, 23))

  overloaded(self: string, a: string, b: string): string;
>overloaded : Symbol(String.overloaded, Decl(tluaColonCallArityMessages.tlua, 40, 18), Decl(tluaColonCallArityMessages.tlua, 41, 23))
>self : Symbol(self, Decl(tluaColonCallArityMessages.tlua, 42, 13))
>a : Symbol(a, Decl(tluaColonCallArityMessages.tlua, 42, 26))
>b : Symbol(b, Decl(tluaColonCallArityMessages.tlua, 42, 37))
}
text:overloaded("only-one");
>text:overloaded : Symbol(String.overloaded, Decl(tluaColonCallArityMessages.tlua, 40, 18), Decl(tluaColonCallArityMessages.tlua, 41, 23))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))
>overloaded : Symbol(String.overloaded, Decl(tluaColonCallArityMessages.tlua, 40, 18), Decl(tluaColonCallArityMessages.tlua, 41, 23))

// A receiver-filled optional parameter genuinely requires nothing written, so a
// clamped minimum of zero is the truth rather than a lost negative.
interface LuaFile {
>LuaFile : Symbol(LuaFile, Decl(lib.luajit.d.tlua, --, --), Decl(tluaColonCallArityMessages.tlua, 44, 28))

  rewind(whence?: string): number;
>rewind : Symbol(LuaFile.rewind, Decl(tluaColonCallArityMessages.tlua, 48, 19))
>whence : Symbol(whence, Decl(tluaColonCallArityMessages.tlua, 49, 9))
}
declare rewindable: LuaFile;
>rewindable : Symbol(rewindable, Decl(tluaColonCallArityMessages.tlua, 51, 7))
>LuaFile : Symbol(LuaFile, Decl(lib.luajit.d.tlua, --, --), Decl(tluaColonCallArityMessages.tlua, 44, 28))

rewindable:rewind("set", 1, 2);
>rewindable:rewind : Symbol(LuaFile.rewind, Decl(tluaColonCallArityMessages.tlua, 48, 19))
>rewindable : Symbol(rewindable, Decl(tluaColonCallArityMessages.tlua, 51, 7))
>rewind : Symbol(LuaFile.rewind, Decl(tluaColonCallArityMessages.tlua, 48, 19))

// The pack-tail branch: every parameter is already filled, so a `...` in final
// position can only supply values Lua would discard -- and the parameter the
// receiver filled is not part of the count the reader sees ("at most 2", not 3).
function spreadIntoColonCall(...: string)
>spreadIntoColonCall : Symbol(spreadIntoColonCall, Decl(tluaColonCallArityMessages.tlua, 52, 31))
> : Symbol((Missing), Decl(tluaColonCallArityMessages.tlua, 57, 29))

  local spread = text:sub(1, 2, ...);
>spread : Symbol(spread, Decl(tluaColonCallArityMessages.tlua, 58, 7))
>text:sub : Symbol(String.sub, Decl(lib.luajit.d.tlua, --, --))
>text : Symbol(text, Decl(tluaColonCallArityMessages.tlua, 7, 5))
>sub : Symbol(String.sub, Decl(lib.luajit.d.tlua, --, --))

end

