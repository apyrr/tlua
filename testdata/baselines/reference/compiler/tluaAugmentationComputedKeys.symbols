-- A key whose literal-ness exists only in its inferred type (no literal
-- spelling, no annotation) deliberately does not route augmentation:
-- attachment decides program shape, so it never consults inferred types.
-- Check-time naming still resolves the read, so viaInferred sees M.typed
-- itself and the write below checks against it instead of augmenting.
local IKEY = makeKey()
>IKEY : Symbol(IKEY, Decl(static.tlua, 64, 5))
>makeKey : Symbol(makeKey, Decl(static.tlua, 4, 7))

local viaInferred = M[IKEY]
