>T : Symbol(T, Decl(tluaAssertModuleTable.tlua, 3, 5))
>vcheck : Symbol(vcheck, Decl(tluaAssertModuleTable.tlua, 6, 3))
>x : Symbol(x, Decl(tluaAssertModuleTable.tlua, 7, 18))
>x : Symbol(x, Decl(tluaAssertModuleTable.tlua, 7, 18))

end

