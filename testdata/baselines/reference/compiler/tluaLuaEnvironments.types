// Per-realm bodies implement the seed's member, so they are not duplicates.
// Parameters take the seed's types, and bodies are checked against it.
if SERVER then
>SERVER : boolean

    function PLUGIN:Start(reason)
>PLUGIN : { Name: string; Start(self: Plugin, reason: string): nil; Think: (self: Plugin) => nil; Primary: { Ammo: string; }; AmmoName: string; Locked: boolean; Open: (self: any) => number; Close: (self: any) => void; Knock(self: { Knock(self: any): number; }): number; }
>Start : any
>reason : string

        local r: string = reason
>r : string
>reason : string

    end
else
    function PLUGIN.Start(self, reason)
>PLUGIN : { Name: string; Start(self: Plugin, reason: string): nil; Think: (self: Plugin) => nil; Primary: { Ammo: string; }; AmmoName: string; Locked: boolean; Open: (self: any) => number; Close: (self: any) => void; Knock(self: { Knock(self: any): number; }): number; }
>Start : any
>self : Plugin
>reason : string

        local wrong: number = reason
>wrong : number
>reason : string

    end
end

