=== tluaMetatableCallAsync.tlua ===
// An async __call pairs the same way a sync one does: the receiver drops out, and the call
// carries the coroutine contract, so only an async context may invoke it.

local execute = async function(query: string): table[]
>execute : async (query: string) => table[]
>async function(query: string): table[]  return {};end : async (query: string) => table[]
>query : string

  return {};
>{} : {}

end;

// The assign form.
local sqlAssigned = setmetatable({}, {
>sqlAssigned : async (query: string) => table[]
>setmetatable({}, {  __call = async function(self: table, query: string): table[]    return execute(query);  end,}) : async (query: string) => table[]
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<T> | nil) => T
>{} : {}
>{  __call = async function(self: table, query: string): table[]    return execute(query);  end,} : { __call: (self: table, query: string) => table[]; }

  __call = async function(self: table, query: string): table[]
>__call : async (self: table, query: string) => table[]
>async function(self: table, query: string): table[]    return execute(query);  end : async (self: table, query: string) => table[]
>self : table
>query : string

    return execute(query);
>execute(query) : table[]
>execute : async (query: string) => table[]
>query : string

  end,
});

// The statement form, mutating in place. The receiver picks up its type from the __call slot.
local sql = {};
>sql : {}
>{} : {}

setmetatable(sql, {
>setmetatable(sql, {  __call = async function(_self, query: string)    return execute(query);  end,}) : async (query: string) => table[]
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<T> | nil) => T
>sql : {}
>{  __call = async function(_self, query: string)    return execute(query);  end,} : { __call: async (_self: {}, query: string) => table[]; }

  __call = async function(_self, query: string)
>__call : async (_self: {}, query: string) => table[]
>async function(_self, query: string)    return execute(query);  end : async (_self: {}, query: string) => table[]
>_self : {}
>query : string

    return execute(query);
>execute(query) : table[]
>execute : async (query: string) => table[]
>query : string

  end,
});

// Own members survive next to the call surface.
local api = { begin = function(self: table): number return 1; end };
>api : { begin: (self: table) => number; }
>{ begin = function(self: table): number return 1; end } : { begin: (self: table) => number; }
>begin : (self: table) => number
>function(self: table): number return 1; end : (self: table) => number
>self : table
>1 : 1

setmetatable(api, {
>setmetatable(api, {  __call = async function(self: table, query: string): table[]    return execute(query);  end,}) : { (query: string): table[]; begin: (self: table) => number; }
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<T> | nil) => T
>api : { begin: (self: table) => number; }
>{  __call = async function(self: table, query: string): table[]    return execute(query);  end,} : { __call: (self: table, query: string) => table[]; }

  __call = async function(self: table, query: string): table[]
>__call : async (self: table, query: string) => table[]
>async function(self: table, query: string): table[]    return execute(query);  end : async (self: table, query: string) => table[]
>self : table
>query : string

    return execute(query);
>execute(query) : table[]
>execute : async (query: string) => table[]
>query : string

  end,
});

async function use(): void
>use : async () => void

  local rows: table[] = sqlAssigned("SELECT 1");
>rows : table[]
>sqlAssigned("SELECT 1") : table[]
>sqlAssigned : async (query: string) => table[]
>"SELECT 1" : "SELECT 1"

  local rows2: table[] = sql("SELECT 1");
>rows2 : table[]
>sql("SELECT 1") : table[]
>sql : async (query: string) => table[]
>"SELECT 1" : "SELECT 1"

  local n: number = api.begin(api);
>n : number
>api.begin(api) : number
>api.begin : (self: table) => number
>api : { (query: string): table[]; begin: (self: table) => number; }
>begin : (self: table) => number
>api : { (query: string): table[]; begin: (self: table) => number; }

  local rows3: table[] = api("SELECT 1");
>rows3 : table[]
>api("SELECT 1") : table[]
>api : { (query: string): table[]; begin: (self: table) => number; }
>"SELECT 1" : "SELECT 1"

end

// The contract holds through the pairing: a sync context may not invoke an async __call.
function syncUse(): void
>syncUse : () => void

  local rows = sql("SELECT 1");
>rows : table[]
>sql("SELECT 1") : table[]
>sql : async (query: string) => table[]
>"SELECT 1" : "SELECT 1"

  local rowsAssigned = sqlAssigned("SELECT 1");
>rowsAssigned : table[]
>sqlAssigned("SELECT 1") : table[]
>sqlAssigned : async (query: string) => table[]
>"SELECT 1" : "SELECT 1"

  local rowsApi = api("SELECT 1");
>rowsApi : table[]
>api("SELECT 1") : table[]
>api : { (query: string): table[]; begin: (self: table) => number; }
>"SELECT 1" : "SELECT 1"

end
sql("top level");
>sql("top level") : table[]
>sql : async (query: string) => table[]
>"top level" : "top level"

// The receiver is implicit, so passing it back is one argument too many.
async function tooMany(): void
>tooMany : async () => void

  sqlAssigned(sqlAssigned, "SELECT 1");
>sqlAssigned(sqlAssigned, "SELECT 1") : table[]
>sqlAssigned : async (query: string) => table[]
>sqlAssigned : async (query: string) => table[]
>"SELECT 1" : "SELECT 1"

end

