// A suspend __call pairs the same way a sync one does: the receiver drops out, and the call
// carries the coroutine contract, so only a suspend context may invoke it.

local execute = suspend function(query: string): table[]
>execute : Symbol(execute, Decl(tluaMetatableCallSuspend.tlua, 3, 5))
>query : Symbol(query, Decl(tluaMetatableCallSuspend.tlua, 3, 33))

  return {};
end;

// The assign form.
local sqlAssigned = setmetatable({}, {
>sqlAssigned : Symbol(sqlAssigned, Decl(tluaMetatableCallSuspend.tlua, 8, 5))
>setmetatable : Symbol(setmetatable, Decl(lib.luajit.d.tlua, --, --))

  __call = suspend function(self: table, query: string): table[]
>__call : Symbol(__call, Decl(tluaMetatableCallSuspend.tlua, 8, 38))
>self : Symbol(self, Decl(tluaMetatableCallSuspend.tlua, 9, 28))
>query : Symbol(query, Decl(tluaMetatableCallSuspend.tlua, 9, 40))

    return execute(query);
>execute : Symbol(execute, Decl(tluaMetatableCallSuspend.tlua, 3, 5))
>query : Symbol(query, Decl(tluaMetatableCallSuspend.tlua, 9, 40))

  end,
});

