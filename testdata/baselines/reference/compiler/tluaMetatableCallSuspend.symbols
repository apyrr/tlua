>__call : Symbol(__call, Decl(tluaMetatableCallSuspend.tlua, 16, 19))
>_self : Symbol(_self, Decl(tluaMetatableCallSuspend.tlua, 17, 28))
>query : Symbol(query, Decl(tluaMetatableCallSuspend.tlua, 17, 34))

    return execute(query);
>execute : Symbol(execute, Decl(tluaMetatableCallSuspend.tlua, 3, 5))
>query : Symbol(query, Decl(tluaMetatableCallSuspend.tlua, 17, 34))

  end,
});

