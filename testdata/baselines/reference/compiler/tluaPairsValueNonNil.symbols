>flag : Symbol(flag, Decl(tluaPairsValueNonNil.tlua, 41, 6))
>pairs : Symbol(pairs, Decl(lib.luajit.d.tlua, --, --))
>flags : Symbol(flags, Decl(tluaPairsValueNonNil.tlua, 40, 5))

    local f: true = flag
>f : Symbol(f, Decl(tluaPairsValueNonNil.tlua, 42, 9))
>flag : Symbol(flag, Decl(tluaPairsValueNonNil.tlua, 41, 6))

end

// A generic value type stays NonNullable<V> until it is instantiated.
local function values<V>(t: Table<string, V>): NonNullable<V>[]
>values : Symbol(values, Decl(tluaPairsValueNonNil.tlua, 43, 3))
>V : Symbol(V, Decl(tluaPairsValueNonNil.tlua, 46, 22))
>t : Symbol(t, Decl(tluaPairsValueNonNil.tlua, 46, 25))
>Table : Symbol(Table, Decl(lib.luajit.d.tlua, --, --))
>V : Symbol(V, Decl(tluaPairsValueNonNil.tlua, 46, 22))
>NonNullable : Symbol(NonNullable, Decl(lib.luajit.d.tlua, --, --))
>V : Symbol(V, Decl(tluaPairsValueNonNil.tlua, 46, 22))

    local out: NonNullable<V>[] = {}
>out : Symbol(out, Decl(tluaPairsValueNonNil.tlua, 47, 9))
>NonNullable : Symbol(NonNullable, Decl(lib.luajit.d.tlua, --, --))
>V : Symbol(V, Decl(tluaPairsValueNonNil.tlua, 46, 22))

    for _, value in pairs(t) do
>_ : Symbol(_, Decl(tluaPairsValueNonNil.tlua, 48, 7))
>value : Symbol(value, Decl(tluaPairsValueNonNil.tlua, 48, 10))
>pairs : Symbol(pairs, Decl(lib.luajit.d.tlua, --, --))
>t : Symbol(t, Decl(tluaPairsValueNonNil.tlua, 46, 25))

        out[#out + 1] = value
>out : Symbol(out, Decl(tluaPairsValueNonNil.tlua, 47, 9))
>out : Symbol(out, Decl(tluaPairsValueNonNil.tlua, 47, 9))
>value : Symbol(value, Decl(tluaPairsValueNonNil.tlua, 48, 10))

    end
    return out
>out : Symbol(out, Decl(tluaPairsValueNonNil.tlua, 47, 9))

end
local boxes: Box[] = values(map)
