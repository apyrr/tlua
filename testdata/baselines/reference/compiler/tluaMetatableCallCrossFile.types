>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<T> | nil) => T
>Gauge : () => string
>{  __call = function(_self: table): number    return 1;  end,} : { __call: (_self: table) => number; }

  __call = function(_self: table): number
>__call : (_self: table) => number
>function(_self: table): number    return 1;  end : (_self: table) => number
>_self : table

    return 1;
>1 : 1

  end,
});
