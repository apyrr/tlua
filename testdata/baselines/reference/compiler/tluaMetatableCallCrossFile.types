=== selfReferential.tlua ===
// The class idiom's metatable reads the symbol back while the pairing is being
// computed; that read sees the plain table, not a false circularity.
Account = Account or {};
>Account = Account or {} : { balance: number; }
>Account : { balance: number; }
>Account or {} : { balance: number; }
>Account : nil
>{} : { balance: number; }

Account.balance = 0;
>Account.balance = 0 : 0
>Account.balance : number
>Account : { balance: number; }
>balance : number
>0 : 0

setmetatable(Account, { __index = Account });
>setmetatable(Account, { __index = Account }) : { balance: number; }
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<T> | nil) => T
>Account : { balance: number; }
>{ __index = Account } : { __index: { balance: number; }; }
>__index : { balance: number; }
>Account : { balance: number; }

=== selfReferentialReads.tlua ===
local balance: number = Account.balance;
>balance : number
>Account.balance : number
>Account : { balance: number; }
>balance : number

