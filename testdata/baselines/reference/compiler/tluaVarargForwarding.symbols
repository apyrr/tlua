> : Symbol((Missing), Decl(tluaVarargForwarding.tlua, 65, 60))
>_ : Symbol(_, Decl(tluaVarargForwarding.tlua, 65, 71))
>V : Symbol(V, Decl(tluaVarargForwarding.tlua, 65, 57))

