=== tluaVarargForwarding.tlua ===
declare function target(a: number, ...: string): void;
>target : Symbol(target, Decl(tluaVarargForwarding.tlua, 0, 0))
>a : Symbol(a, Decl(tluaVarargForwarding.tlua, 0, 24))
> : Symbol((Missing), Decl(tluaVarargForwarding.tlua, 0, 34))

function forward(...: any): void
>forward : Symbol(forward, Decl(tluaVarargForwarding.tlua, 0, 54))
> : Symbol((Missing), Decl(tluaVarargForwarding.tlua, 2, 17))

  // Forwarding into a rest parameter, in tail position.
  print(...);
>print : Symbol(print, Decl(lib.luajit.d.tlua, --, --))

  print("x", ...);
>print : Symbol(print, Decl(lib.luajit.d.tlua, --, --))

  target(1, ...);
>target : Symbol(target, Decl(tluaVarargForwarding.tlua, 0, 0))

  // The Lua libraries take the pack through their own rest tails.
  local ok = pcall(forward, ...);
>ok : Symbol(ok, Decl(tluaVarargForwarding.tlua, 9, 7))
>pcall : Symbol(pcall, Decl(lib.luajit.d.tlua, --, --), Decl(lib.luajit.d.tlua, --, --))
>forward : Symbol(forward, Decl(tluaVarargForwarding.tlua, 0, 54))

  local count = select("#", ...);
>count : Symbol(count, Decl(tluaVarargForwarding.tlua, 10, 7))
>select : Symbol(select, Decl(lib.luajit.d.tlua, --, --), Decl(lib.luajit.d.tlua, --, --))

  // Forwarding into a fixed parameter passes `any | nil`, because the tail may
  // run out before it. `tostring(value: any)` accepts nil -- and so does Lua,
  // where `tostring(nil)` is "nil" -- so this is legal, and no arity rule is
  // involved.
  tostring(...);
>tostring : Symbol(tostring, Decl(lib.luajit.d.tlua, --, --))

  // Parenthesized truncation says "exactly one value" explicitly. Same result.
  tostring((...));
>tostring : Symbol(tostring, Decl(lib.luajit.d.tlua, --, --))

  // `error()` takes no argument in Lua, and its parameters are optional here, so
  // a possibly-empty tail forwards cleanly.
  error(...);
>error : Symbol(error, Decl(lib.luajit.d.tlua, --, --))

end

declare function needsString(value: string): void;
>needsString : Symbol(needsString, Decl(tluaVarargForwarding.tlua, 24, 3))
>value : Symbol(value, Decl(tluaVarargForwarding.tlua, 26, 29))

function forwardIntoRequired(...: number): void
>forwardIntoRequired : Symbol(forwardIntoRequired, Decl(tluaVarargForwarding.tlua, 26, 50))
> : Symbol((Missing), Decl(tluaVarargForwarding.tlua, 28, 29))

  // The tail's value may be absent, so a parameter that cannot hold nil rejects
  // it -- an ordinary assignability error naming the real type, not an arity
  // rule. This is the check that keeps a maybe-empty tail out of a slot that
  // needs a value.
  needsString(...);
>needsString : Symbol(needsString, Decl(tluaVarargForwarding.tlua, 24, 3))

end

// Lib sanity assertions on the inherited-lib rest rewrite.
declare function twoArgs(a: number, b: string): number;
>twoArgs : Symbol(twoArgs, Decl(tluaVarargForwarding.tlua, 34, 3))
>a : Symbol(a, Decl(tluaVarargForwarding.tlua, 37, 25))
>b : Symbol(b, Decl(tluaVarargForwarding.tlua, 37, 35))

// `ReturnType<T>` still resolves: its `(...: any) => infer R` survived the
// rewrite with `R` bound. The negative assertion is the real gate -- if the
// rewrite ate the `infer`, `R` degrades to `any` and only a *mismatch* can
// detect it, since `any` satisfies every positive annotation.
type Ret = ReturnType<typeof twoArgs>;
>Ret : Symbol(Ret, Decl(tluaVarargForwarding.tlua, 37, 55))
>ReturnType : Symbol(ReturnType, Decl(lib.luajit.d.tlua, --, --))
>twoArgs : Symbol(twoArgs, Decl(tluaVarargForwarding.tlua, 34, 3))

local ret: Ret = 1;
>ret : Symbol(ret, Decl(tluaVarargForwarding.tlua, 44, 5))
>Ret : Symbol(Ret, Decl(tluaVarargForwarding.tlua, 37, 55))

local badRet: Ret = "a";
>badRet : Symbol(badRet, Decl(tluaVarargForwarding.tlua, 45, 5))
>Ret : Symbol(Ret, Decl(tluaVarargForwarding.tlua, 37, 55))

// `infer` in a vararg annotation infers the pack's *element* type and must
// carry no implicit `unknown[]` constraint. Two gates:
//
// (1) Direct: inferring from a function type's vararg position yields the
// element type itself, not an array of it.
declare varfn: (first: string, ...: number) => boolean;
>varfn : Symbol(varfn, Decl(tluaVarargForwarding.tlua, 52, 7))
>first : Symbol(first, Decl(tluaVarargForwarding.tlua, 52, 16))
> : Symbol((Missing), Decl(tluaVarargForwarding.tlua, 52, 30))

type VarargElem<T> = T extends (first: any, ...: infer E) => any ? E : never;
>VarargElem : Symbol(VarargElem, Decl(tluaVarargForwarding.tlua, 52, 55))
>T : Symbol(T, Decl(tluaVarargForwarding.tlua, 53, 16))
>T : Symbol(T, Decl(tluaVarargForwarding.tlua, 53, 16))
>first : Symbol(first, Decl(tluaVarargForwarding.tlua, 53, 32))
> : Symbol((Missing), Decl(tluaVarargForwarding.tlua, 53, 43))
>E : Symbol(E, Decl(tluaVarargForwarding.tlua, 53, 54))
>E : Symbol(E, Decl(tluaVarargForwarding.tlua, 53, 54))

type Elem = VarargElem<typeof varfn>;
>Elem : Symbol(Elem, Decl(tluaVarargForwarding.tlua, 53, 77))
>VarargElem : Symbol(VarargElem, Decl(tluaVarargForwarding.tlua, 52, 55))
>varfn : Symbol(varfn, Decl(tluaVarargForwarding.tlua, 52, 7))

local elem: Elem = 1;
>elem : Symbol(elem, Decl(tluaVarargForwarding.tlua, 55, 5))
>Elem : Symbol(Elem, Decl(tluaVarargForwarding.tlua, 53, 77))

local badElem: Elem = "a";
