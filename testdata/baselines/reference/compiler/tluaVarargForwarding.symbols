>T : Symbol(T, Decl(tluaVarargForwarding.tlua, 65, 13))
>T : Symbol(T, Decl(tluaVarargForwarding.tlua, 65, 13))
>invoke : Symbol(invoke, Decl(tluaVarargForwarding.tlua, 65, 37))
>value : Symbol(value, Decl(tluaVarargForwarding.tlua, 65, 45))
