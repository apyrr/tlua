-- Alias chains follow literal freshness: an annotated or const-asserted
-- source stays literal through the hop, while a bare literal initializer
-- widens once aliased, so FALIAS stops routing augmentation exactly as its
-- symbol type (string) would.
local ALIAS = AKEY
>ALIAS : "annotated"
>AKEY : "annotated"

local viaAlias = M[ALIAS]
>viaAlias : { flag: boolean; aliased: string; }
>M[ALIAS] : { flag: boolean; aliased: string; }
>M : { sub: { helper(): number; }; 1: { count: number; }; annotated: { flag: boolean; aliased: string; }; typed: { deep: number; }; casted: { chained: number; kept: number; }; widened: {}; }
>ALIAS : "annotated"

viaAlias.aliased = "yes"
>viaAlias.aliased = "yes" : "yes"
>viaAlias.aliased : string
>viaAlias : { flag: boolean; aliased: string; }
>aliased : string
>"yes" : "yes"

