-- A const assertion keeps the literal, so attachment still routes; a plain
-- widening cast suppresses the literal by design, so the write below checks
-- against M.widened's own type instead of declaring a new member on it.
local viaConst = M[CKEY]
>viaConst : { chained: number; kept: number; }
>M[CKEY] : { chained: number; kept: number; }
>M : { sub: { helper(): number; }; 1: { count: number; }; annotated: { flag: boolean; aliased: string; }; typed: { deep: number; }; casted: { chained: number; kept: number; }; widened: {}; }
>CKEY : "casted"

viaConst.kept = 4
>viaConst.kept = 4 : 4
>viaConst.kept : number
>viaConst : { chained: number; kept: number; }
>kept : number
>4 : 4

