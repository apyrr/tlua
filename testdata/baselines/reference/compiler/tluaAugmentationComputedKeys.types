>CALIAS : "casted"
>CKEY : "casted"

local viaConstAlias = M[CALIAS]
>viaConstAlias : { chained: number; kept: number; }
>M[CALIAS] : { chained: number; kept: number; }
>M : { sub: { helper(): number; }; 1: { count: number; }; annotated: { flag: boolean; aliased: string; }; typed: { deep: number; }; casted: { chained: number; kept: number; }; widened: {}; }
>CALIAS : "casted"

viaConstAlias.chained = 6
>viaConstAlias.chained = 6 : 6
>viaConstAlias.chained : number
>viaConstAlias : { chained: number; kept: number; }
