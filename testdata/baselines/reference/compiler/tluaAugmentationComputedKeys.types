//// [tests/cases/compiler/tluaAugmentationComputedKeys.tlua] ////

=== crash.tlua ===
-- Augmentation-time receiver resolution names element-access keys without
-- resolving any type: attachment runs before the checker's global and
-- synthetic types exist. Each key below used to force a type computation
-- (array annotation, string member lookup, arithmetic, property read) and
-- crash checker initialization.
local names: string[] = {"apple"}
>names : string[]
>{"apple"} : { 1: string; }

local akey = names[1]
>akey : string | nil
>names[1] : string | nil
>names : string[]
>1 : 1

local registry1 = {}
>registry1 : {}
>{} : {}

local e1 = registry1[akey]
>e1 : any
>registry1[akey] : any
>registry1 : {}
>akey : string | nil

e1.x = 1
>e1.x = 1 : 1
>e1.x : any
>e1 : any
>x : any
>1 : 1

local skey = ("apple"):upper()
>skey : string
>("apple"):upper() : string
>("apple"):upper : (self: string) => string
>("apple") : "apple"
>"apple" : "apple"
>upper : (self: string) => string

local registry2 = {}
>registry2 : {}
>{} : {}

local e2 = registry2[skey]
>e2 : any
>registry2[skey] : any
>registry2 : {}
>skey : string

e2.x = 1
>e2.x = 1 : 1
>e2.x : any
>e2 : any
>x : any
>1 : 1

local nkey = 1 + 2
>nkey : number
>1 + 2 : number
>1 : 1
>2 : 2

local registry3 = {}
>registry3 : {}
>{} : {}

local e3 = registry3[nkey]
>e3 : any
>registry3[nkey] : any
>registry3 : {}
>nkey : number

e3.x = 1
>e3.x = 1 : 1
>e3.x : any
>e3 : any
>x : any
>1 : 1

local t = { name = "a" }
>t : { name: string; }
>{ name = "a" } : { name: string; }
>name : string
>"a" : "a"

local tkey = t.name
>tkey : string
>t.name : string
>t : { name: string; }
>name : string

local registry4 = {}
>registry4 : {}
>{} : {}

local e4 = registry4[tkey]
>e4 : any
>registry4[tkey] : any
>registry4 : {}
>tkey : string

e4.x = 1
>e4.x = 1 : 1
>e4.x : any
>e4 : any
>x : any
>1 : 1

=== static.tlua ===
-- Literal spellings still resolve statically, so a constant key keeps
-- routing augmentation through the element access: string and numeric
-- initializers, a literal type annotation, and a constant alias chain.
type TKey = "typed"
>TKey : "typed"

declare makeKey: () => TKey
>makeKey : () => TKey

local KEY = "sub"
>KEY : string
>"sub" : "sub"

local NKEY = 1
>NKEY : number
>1 : 1

local AKEY: "annotated" = "annotated"
>AKEY : "annotated"
>"annotated" : "annotated"

local TKEY: TKey = makeKey()
>TKEY : "typed"
>makeKey() : "typed"
>makeKey : () => TKey

local CKEY = ("casted") as const
>CKEY : "casted"
>("casted") as const : "casted"
>("casted") : "casted"
>"casted" : "casted"

local WKEY = "widened" as string
>WKEY : string
>"widened" as string : string
>"widened" : "widened"

local M = {}
>M : { sub: { helper(): number; }; 1: { count: number; }; annotated: { flag: boolean; aliased: string; }; typed: { deep: number; }; casted: { chained: number; kept: number; }; widened: {}; }
>{} : { sub: { helper(): number; }; 1: { count: number; }; annotated: { flag: boolean; aliased: string; }; typed: { deep: number; }; casted: { chained: number; kept: number; }; widened: {}; }

M.sub = {}
>M.sub = {} : { helper(): number; }
>M.sub : { helper(): number; }
>M : { sub: { helper(): number; }; 1: { count: number; }; annotated: { flag: boolean; aliased: string; }; typed: { deep: number; }; casted: { chained: number; kept: number; }; widened: {}; }
>sub : { helper(): number; }
>{} : { helper(): number; }

M[1] = {}
>M[1] = {} : { count: number; }
>M[1] : { count: number; }
>M : { sub: { helper(): number; }; 1: { count: number; }; annotated: { flag: boolean; aliased: string; }; typed: { deep: number; }; casted: { chained: number; kept: number; }; widened: {}; }
>1 : 1
>{} : { count: number; }

M.annotated = {}
>M.annotated = {} : { flag: boolean; aliased: string; }
>M.annotated : { flag: boolean; aliased: string; }
>M : { sub: { helper(): number; }; 1: { count: number; }; annotated: { flag: boolean; aliased: string; }; typed: { deep: number; }; casted: { chained: number; kept: number; }; widened: {}; }
