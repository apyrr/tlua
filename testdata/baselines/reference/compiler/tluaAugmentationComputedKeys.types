>M.casted : { chained: number; kept: number; }
>M : { sub: { helper(): number; }; 1: { count: number; }; annotated: { flag: boolean; aliased: string; }; typed: { deep: number; }; casted: { chained: number; kept: number; }; widened: {}; }
>casted : { chained: number; kept: number; }
>{} : { chained: number; kept: number; }

M.widened = {}
>M.widened = {} : {}
>M.widened : {}
