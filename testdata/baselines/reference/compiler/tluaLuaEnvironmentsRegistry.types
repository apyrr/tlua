//// [tests/cases/compiler/tluaLuaEnvironmentsRegistry.tlua] ////

=== host.d.tlua ===
interface Entity {
    GetPos(self: Entity): number;
>GetPos : (self: Entity) => number
>self : Entity
}
interface ENT extends Entity {
    PrintName: string;
>PrintName : string
}
interface EFFECT {}
interface Effects {}
interface ScriptedEntities {
    // An explicit declaration keeps its own type.
    base_anim: ENT;
>base_anim : ENT
}
// One signature, so the lookup does not depend on overload order across
// merged declarations.
interface EntsLib {
    FindByClass<K extends string>(name: K): (K extends keyof ScriptedEntities ? ScriptedEntities[K] : Entity)[];
>FindByClass : <K extends string>(name: K) => (K extends keyof ScriptedEntities ? ScriptedEntities[K] : Entity)[]
>name : K
}
declare ents: EntsLib
>ents : EntsLib

// A folder and a single file each register their name.
=== addons/a/lua/entities/door/shared.tlua ===
ENT.PrintName = "Door"
>ENT.PrintName = "Door" : "Door"
>ENT.PrintName : string
>ENT : ENT & { Open: (self: ENT & { Open: any; }) => number; }
>PrintName : string
>"Door" : "Door"

function ENT:Open(): number
>ENT : ENT & { Open: (self: ENT & { Open: any; }) => number; }
>Open : (self: ENT & { Open: any; }) => number

    return 1
>1 : 1

end

=== addons/a/lua/entities/lamp.tlua ===
ENT.Brightness = 5
>ENT.Brightness = 5 : 5
>ENT.Brightness : number
>ENT : ENT & { Brightness: number; }
>Brightness : number
>5 : 5

// Two addons shipping one class name register the union of both tables.
=== addons/b/lua/entities/lamp.tlua ===
ENT.Color = "red"
>ENT.Color = "red" : "red"
>ENT.Color : string
>ENT : ENT & { Color: string; }
>Color : string
>"red" : "red"

=== addons/a/lua/effects/spark.tlua ===
EFFECT.Size = 1
>EFFECT.Size = 1 : 1
>EFFECT.Size : any
>EFFECT : any
>Size : any
>1 : 1

