// A stable local alias names the same constructor, so a write through either
// spelling declares the member on one table.
local aliasRoot = {};
>aliasRoot : { member: number; }
>{} : { member: number; }

local alias = aliasRoot;
>alias : { member: number; }
>aliasRoot : { member: number; }

alias.member = 1;
>alias.member = 1 : 1
>alias.member : number
>alias : { member: number; }
>member : number
>1 : 1

