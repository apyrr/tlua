>type(err) == "table" : boolean
>type(err) : "boolean" | "cdata" | "function" | "nil" | "number" | "string" | "table" | "thread" | "userdata"
>type : (value: any) => "nil" | "number" | "string" | "boolean" | "table" | "function" | "thread" | "userdata" | "cdata"
>err : unknown
>"table" : "table"
>type(err.code) == "string" : boolean
>type(err.code) : "boolean" | "cdata" | "function" | "nil" | "number" | "string" | "table" | "thread" | "userdata"
>type : (value: any) => "nil" | "number" | "string" | "boolean" | "table" | "function" | "thread" | "userdata" | "cdata"
>err.code : unknown
>err : Table<{}, unknown>
>code : unknown
>"string" : "string"

        return err.code
>err.code : string
>err : Table<{}, unknown>
>code : string

    end
    return nil
end
