-- A generic narrows to an intersection with it. It reads any key, but a generic
-- is indexed for reading only, so writes need a stated type.
local function readGeneric<T>(value: T): unknown
>readGeneric : <T>(value: T) => unknown
>value : T

    if type(value) == "table" then
>type(value) == "table" : boolean
>type(value) : "boolean" | "cdata" | "function" | "nil" | "number" | "string" | "table" | "thread" | "userdata"
>type : (value: any) => "nil" | "number" | "string" | "boolean" | "table" | "function" | "thread" | "userdata" | "cdata"
>value : T
>"table" : "table"

        value.field = 1
>value.field = 1 : 1
>value.field : any
>value : T & Table<{}, unknown>
>field : any
>1 : 1

        value["slot"] = 2
>value["slot"] = 2 : 2
>value["slot"] : any
>value : T & Table<{}, unknown>
>"slot" : "slot"
>2 : 2

        return value.field
>value.field : unknown
>value : T & Table<{}, unknown>
>field : unknown

    end
    return nil
end

