>t : Table<K, V>

        if type(value) == "table" then
>type(value) == "table" : boolean
>type(value) : "boolean" | "cdata" | "function" | "nil" | "number" | "string" | "table" | "thread" | "userdata"
>type : (value: any) => "nil" | "number" | "string" | "boolean" | "table" | "function" | "thread" | "userdata" | "cdata"
>value : V & {}
>"table" : "table"

            local inner: unknown = value.anything
>inner : unknown
>value.anything : unknown
>value : V & Table<{}, unknown>
>anything : unknown

        end
        rawset(copy, key, value)
>rawset(copy, key, value) : Table<K, V>
