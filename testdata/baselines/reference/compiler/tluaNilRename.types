//// [tests/cases/compiler/tluaNilRename.tlua] ////

=== tluaNilRename.tlua ===
// `nil` works as a type and a value.
local a: nil = nil;
>a : nil

local b = nil;
>b : any

// A type query can name it too.
type Nil = typeof nil;
>Nil : nil
>nil : nil

local c: Nil = nil;
>c : nil

// Optional properties surface as `nil`.
interface Box {
	value?: number;
>value : number | nil
}
local g: Box = {};
>g : Box
>{} : {}

local h = g.value;
>h : number | nil
>g.value : number | nil
>g : Box
>value : number | nil

