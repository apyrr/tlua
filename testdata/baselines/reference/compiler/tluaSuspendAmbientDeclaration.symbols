//// [tests/cases/compiler/tluaSuspendAmbientDeclaration.tlua] ////

=== tluaSuspendAmbientDeclaration.tlua ===
// The ambient form of the suspend contract: `declare suspend function` is
// what declaration files emit, so the checker must both accept it and keep
// enforcing caller-context coloring through it.

declare suspend function fetchOk(url: string): (boolean, any);
>fetchOk : Symbol(fetchOk, Decl(tluaSuspendAmbientDeclaration.tlua, 0, 0))
>url : Symbol(url, Decl(tluaSuspendAmbientDeclaration.tlua, 4, 33))

// Error: direct call from a sync function.
function syncCaller(): void
>syncCaller : Symbol(syncCaller, Decl(tluaSuspendAmbientDeclaration.tlua, 4, 62))

  fetchOk("nope");
>fetchOk : Symbol(fetchOk, Decl(tluaSuspendAmbientDeclaration.tlua, 0, 0))

end

// OK: call from a suspend context.
suspend function suspendCaller(): number
>suspendCaller : Symbol(suspendCaller, Decl(tluaSuspendAmbientDeclaration.tlua, 9, 3))

  local ok, res = fetchOk("https://example.com");
>ok : Symbol(ok, Decl(tluaSuspendAmbientDeclaration.tlua, 13, 7))
>res : Symbol(res, Decl(tluaSuspendAmbientDeclaration.tlua, 13, 11))
>fetchOk : Symbol(fetchOk, Decl(tluaSuspendAmbientDeclaration.tlua, 0, 0))

  if ok then
>ok : Symbol(ok, Decl(tluaSuspendAmbientDeclaration.tlua, 13, 7))

    return 1;
  end
  return 0;
end

// OK: passing the ambient suspend function as a value is not a call.
coroutine.create(fetchOk);
>coroutine.create : Symbol(CoroutineLib.create, Decl(lib.luajit.d.tlua, --, --))
>coroutine : Symbol(coroutine, Decl(lib.luajit.d.tlua, --, --))
>create : Symbol(CoroutineLib.create, Decl(lib.luajit.d.tlua, --, --))
>fetchOk : Symbol(fetchOk, Decl(tluaSuspendAmbientDeclaration.tlua, 0, 0))

// Error: a concrete sync signature still rejects the ambient suspend function.
local concrete: (url: string) => (boolean, any) = fetchOk;
>concrete : Symbol(concrete, Decl(tluaSuspendAmbientDeclaration.tlua, 24, 5))
>url : Symbol(url, Decl(tluaSuspendAmbientDeclaration.tlua, 24, 17))
>fetchOk : Symbol(fetchOk, Decl(tluaSuspendAmbientDeclaration.tlua, 0, 0))

// Error: `declare` must precede `suspend`.
suspend declare function backwards(): void;
>backwards : Symbol(backwards, Decl(tluaSuspendAmbientDeclaration.tlua, 24, 58))

