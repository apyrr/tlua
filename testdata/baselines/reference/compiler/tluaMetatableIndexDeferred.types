=== tluaMetatableIndexDeferred.tlua ===
// A function-form __index generic in a key whose domain is still generic where the pairing
// forms contributes the generic mapped type it spells. The registry-derived client shape from
// the report: the procedure names are a conditional over the prefix, unknowable in the body.

type ReproRealm = "server" | "client"
>ReproRealm : ReproRealm

interface ReproProcedure<TInput, TOutput, TRealm extends ReproRealm> {
    input?: TInput;
>input : TInput | nil

    output?: TOutput;
>output : TOutput | nil

    realm: TRealm;
>realm : TRealm
}

type ReproRegisteredRouter<TPrefix extends string, TRoutes> = TRoutes & {
>ReproRegisteredRouter : ReproRegisteredRouter<TPrefix, TRoutes>

    __routerType?: {
>__routerType : { prefix: TPrefix; routes: TRoutes; } | nil

        prefix: TPrefix;
>prefix : TPrefix

        routes: TRoutes;
>routes : TRoutes

    };
}

interface ReproModules {
    first: ReproRegisteredRouter<"service", {
>first : ReproRegisteredRouter<"service", { ping: ReproProcedure<{ value: number; }, string, "server">; pushed: ReproProcedure<{}, boolean, "client">; }>

        ping: ReproProcedure<{ value: number }, string, "server">;
>ping : ReproProcedure<{ value: number; }, string, "server">
>value : number

        pushed: ReproProcedure<{}, boolean, "client">;
>pushed : ReproProcedure<{}, boolean, "client">

    }>;

    second: ReproRegisteredRouter<"other", {
>second : ReproRegisteredRouter<"other", { lookup: ReproProcedure<{ id: string; }, number, "server">; }>

        lookup: ReproProcedure<{ id: string }, number, "server">;
>lookup : ReproProcedure<{ id: string; }, number, "server">
>id : string

    }>;
}

type ReproProcedureNames<
>ReproProcedureNames : ReproProcedureNames<TPrefix, TRealm>

    TPrefix extends string,
    TRealm extends ReproRealm
> = {
    [TModuleName in keyof ReproModules]:
        ReproModules[TModuleName] extends {
            __routerType?: {
>__routerType : { prefix: TPrefix; routes: infer TRoutes; } | nil

                prefix: TPrefix;
>prefix : TPrefix

                routes: infer TRoutes;
>routes : TRoutes

            };
        }
            ? {
                [TName in keyof TRoutes]:
                    TRoutes[TName] extends
                        ReproProcedure<unknown, unknown, TRealm>
                            ? TName
                            : never;
            }[keyof TRoutes]
            : never;
}[keyof ReproModules];

type ReproProcedureAt<
>ReproProcedureAt : ReproProcedureAt<TPrefix, TRealm, TName>

    TPrefix extends string,
    TRealm extends ReproRealm,
    TName
> = {
    [TModuleName in keyof ReproModules]:
        ReproModules[TModuleName] extends {
            __routerType?: {
>__routerType : { prefix: TPrefix; routes: infer TRoutes; } | nil

                prefix: TPrefix;
>prefix : TPrefix

                routes: infer TRoutes;
>routes : TRoutes

            };
        }
            ? TName extends keyof TRoutes
                ? TRoutes[TName] extends
                    ReproProcedure<unknown, unknown, TRealm>
                        ? TRoutes[TName]
                        : never
                : never
            : never;
}[keyof ReproModules];

type ReproOutput<TProcedure> =
>ReproOutput : ReproOutput<TProcedure>

    TProcedure extends
        ReproProcedure<unknown, infer TOutput, ReproRealm>
            ? TOutput
            : never;

type ReproCaller<TProcedure> =
>ReproCaller : ReproCaller<TProcedure>

    () => ReproOutput<TProcedure>;

type ReproClient<
>ReproClient : ReproClient<TPrefix, TRealm>

    TPrefix extends string,
    TRealm extends ReproRealm
> = {
    [TName in ReproProcedureNames<TPrefix, TRealm>]:
        ReproCaller<
            ReproProcedureAt<TPrefix, TRealm, TName>
        >;
};

declare function reproBuildCaller<
>reproBuildCaller : <TPrefix extends string, TName extends ReproProcedureNames<TPrefix, "server"> & string>(prefix: TPrefix, name: TName) => ReproClient<TPrefix, "server">[TName]

    TPrefix extends string,
    TName extends
        ReproProcedureNames<TPrefix, "server"> & string
>(
    prefix: TPrefix,
>prefix : TPrefix

    name: TName
>name : TName

): ReproClient<TPrefix, "server">[TName];

