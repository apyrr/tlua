//// [tests/cases/compiler/tluaUncheckedIndexedAccessDefault.tlua] ////

=== tluaUncheckedIndexedAccessDefault.tlua ===
// Indexing a key a table does not have yields nil in Lua, so an index read widens to
// `V | nil` with nothing to switch on: noUncheckedIndexedAccess is the default here.
// In TypeScript the option is a strictness opt-in; for Lua it is plain accuracy, so it
// does not follow `strict` either.

interface Registry { [key: string]: number }
>Registry : Symbol(Registry, Decl(tluaUncheckedIndexedAccessDefault.tlua, 0, 0))
>key : Symbol(key, Decl(tluaUncheckedIndexedAccessDefault.tlua, 5, 22))

declare reg: Registry;
>reg : Symbol(reg, Decl(tluaUncheckedIndexedAccessDefault.tlua, 6, 7))
>Registry : Symbol(Registry, Decl(tluaUncheckedIndexedAccessDefault.tlua, 0, 0))

local direct: number | nil = reg["a"];
>direct : Symbol(direct, Decl(tluaUncheckedIndexedAccessDefault.tlua, 7, 5))
>reg : Symbol(reg, Decl(tluaUncheckedIndexedAccessDefault.tlua, 6, 7))

local wrong: number = reg["a"];
>wrong : Symbol(wrong, Decl(tluaUncheckedIndexedAccessDefault.tlua, 8, 5))
>reg : Symbol(reg, Decl(tluaUncheckedIndexedAccessDefault.tlua, 6, 7))

// A number-key table is the same shape -- there is no length to index against -- so an
// element read widens the same way.
declare xs: number[];
>xs : Symbol(xs, Decl(tluaUncheckedIndexedAccessDefault.tlua, 12, 7))

local first: number | nil = xs[1];
>first : Symbol(first, Decl(tluaUncheckedIndexedAccessDefault.tlua, 13, 5))
>xs : Symbol(xs, Decl(tluaUncheckedIndexedAccessDefault.tlua, 12, 7))

// Which is the point: the widening is what gives a presence guard something to narrow.
// Without it the condition would be the declared value type -- here the literal `true` --
// and the guard would prove nothing.
local queue: Table<string, true> = {};
>queue : Symbol(queue, Decl(tluaUncheckedIndexedAccessDefault.tlua, 18, 5))
>Table : Symbol(Table, Decl(lib.luajit.d.tlua, --, --))

if queue["k"] then
>queue : Symbol(queue, Decl(tluaUncheckedIndexedAccessDefault.tlua, 18, 5))

  local seen: true = queue["k"];
>seen : Symbol(seen, Decl(tluaUncheckedIndexedAccessDefault.tlua, 20, 7))
>queue : Symbol(queue, Decl(tluaUncheckedIndexedAccessDefault.tlua, 18, 5))

end

// A declared property is not an index signature and keeps its exact type; only the keys
// the index signature opens are the ones that might not be there.
interface Named { label: string; [key: string]: string }
>Named : Symbol(Named, Decl(tluaUncheckedIndexedAccessDefault.tlua, 21, 3))
>label : Symbol(Named.label, Decl(tluaUncheckedIndexedAccessDefault.tlua, 25, 17))
>key : Symbol(key, Decl(tluaUncheckedIndexedAccessDefault.tlua, 25, 34))

declare named: Named;
>named : Symbol(named, Decl(tluaUncheckedIndexedAccessDefault.tlua, 26, 7))
>Named : Symbol(Named, Decl(tluaUncheckedIndexedAccessDefault.tlua, 21, 3))

local label: string = named.label;
>label : Symbol(label, Decl(tluaUncheckedIndexedAccessDefault.tlua, 27, 5))
>named.label : Symbol(Named.label, Decl(tluaUncheckedIndexedAccessDefault.tlua, 25, 17))
>named : Symbol(named, Decl(tluaUncheckedIndexedAccessDefault.tlua, 26, 7))
>label : Symbol(Named.label, Decl(tluaUncheckedIndexedAccessDefault.tlua, 25, 17))

local other: string | nil = named["other"];
>other : Symbol(other, Decl(tluaUncheckedIndexedAccessDefault.tlua, 28, 5))
>named : Symbol(named, Decl(tluaUncheckedIndexedAccessDefault.tlua, 26, 7))

// It is a read-position rule: a write still takes the declared value type.
reg["a"] = 1;
>reg : Symbol(reg, Decl(tluaUncheckedIndexedAccessDefault.tlua, 6, 7))

// A union can answer the same key from a declared property in one arm and an index
// signature in another. The index-signature arm may hold no such key, so the read is
// possibly nil -- through both spellings of the access, which must always agree.
declare mixed: Registry | { a: boolean };
>mixed : Symbol(mixed, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 7))
>Registry : Symbol(Registry, Decl(tluaUncheckedIndexedAccessDefault.tlua, 0, 0))
>a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))

local viaIndex: number | boolean | nil = mixed["a"];
>viaIndex : Symbol(viaIndex, Decl(tluaUncheckedIndexedAccessDefault.tlua, 37, 5))
>mixed : Symbol(mixed, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 7))
>"a" : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))

local viaDot: number | boolean | nil = mixed.a;
>viaDot : Symbol(viaDot, Decl(tluaUncheckedIndexedAccessDefault.tlua, 38, 5))
>mixed.a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))
>mixed : Symbol(mixed, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 7))
>a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))

local viaIndexUnsafe: number | boolean = mixed["a"];
>viaIndexUnsafe : Symbol(viaIndexUnsafe, Decl(tluaUncheckedIndexedAccessDefault.tlua, 39, 5))
>mixed : Symbol(mixed, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 7))
>"a" : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))

local viaDotUnsafe: number | boolean = mixed.a;
>viaDotUnsafe : Symbol(viaDotUnsafe, Decl(tluaUncheckedIndexedAccessDefault.tlua, 40, 5))
>mixed.a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))
>mixed : Symbol(mixed, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 7))
>a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))

if mixed.a then
>mixed.a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))
>mixed : Symbol(mixed, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 7))
>a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))

  local present: number | boolean = mixed.a;
>present : Symbol(present, Decl(tluaUncheckedIndexedAccessDefault.tlua, 42, 7))
>mixed.a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))
>mixed : Symbol(mixed, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 7))
>a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))

end
mixed.a = 1;
>mixed.a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))
>mixed : Symbol(mixed, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 7))
>a : Symbol(a, Decl(tluaUncheckedIndexedAccessDefault.tlua, 36, 27))

