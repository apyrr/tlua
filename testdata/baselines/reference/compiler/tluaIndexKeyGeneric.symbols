local k2: K2 = true;
>k2 : Symbol(k2, Decl(tluaIndexKeyGeneric.tlua, 20, 5))
>K2 : Symbol(K2, Decl(tluaIndexKeyGeneric.tlua, 18, 19))

// The index resolves inside a generic body: `Table<K, V>[K]` is `V`, never a deferred
// indexed access nothing can simplify. Resolving it keeps the read widening: an index
// signature keyed by a type parameter is as open as any other, so the value is `V | nil`
// and a helper that means to hand the absence back says so.
function get<K, V>(t: Table<K, V>, k: K): V | nil
>get : Symbol(get, Decl(tluaIndexKeyGeneric.tlua, 20, 20))
>K : Symbol(K, Decl(tluaIndexKeyGeneric.tlua, 26, 13))
