>K : Symbol(K, Decl(tluaIndexKeyGeneric.tlua, 26, 13))
>V : Symbol(V, Decl(tluaIndexKeyGeneric.tlua, 26, 15))
>k : Symbol(k, Decl(tluaIndexKeyGeneric.tlua, 26, 34))
>K : Symbol(K, Decl(tluaIndexKeyGeneric.tlua, 26, 13))
>V : Symbol(V, Decl(tluaIndexKeyGeneric.tlua, 26, 15))

  local v = t[k];
>v : Symbol(v, Decl(tluaIndexKeyGeneric.tlua, 27, 7))
>t : Symbol(t, Decl(tluaIndexKeyGeneric.tlua, 26, 19))
>k : Symbol(k, Decl(tluaIndexKeyGeneric.tlua, 26, 34))

  return v;
>v : Symbol(v, Decl(tluaIndexKeyGeneric.tlua, 27, 7))

end

