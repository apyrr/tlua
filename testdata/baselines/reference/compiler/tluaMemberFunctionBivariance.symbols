>Animal : Symbol(Animal, Decl(tluaMemberFunctionBivariance.tlua, 11, 55))

    return self.name
>self.name : Symbol(Animal.name, Decl(tluaMemberFunctionBivariance.tlua, 13, 40))
>self : Symbol(self, Decl(tluaMemberFunctionBivariance.tlua, 7, 23))
