>ov.a : string | number
>ov : { n: number; a: string | number; b: boolean; }
>a : string | number

local justB: boolean = ov.b;
>justB : boolean
>ov.b : boolean
>ov : { n: number; a: string | number; b: boolean; }
>b : boolean

// A virtual property satisfies an interface that requires it, with __newindex typing the write.
interface StateRef<T> { value: T; get(self: StateRef<T>): T }
>value : T
>get : (self: StateRef<T>) => T
>self : StateRef<T>

function createState<T>(initial: T): StateRef<T>
>createState : <T>(initial: T) => StateRef<T>
>initial : T

    local value = initial
>value : T
>initial : T

    return setmetatable({ get = function() return value end }, {
>setmetatable({ get = function() return value end }, {        __index = function(_, key: "value"): T return value end,        __newindex = function(_, key: "value", next: T) value = next end,    }) : { get: () => T; value: T; }
>setmetatable : <T_1 extends table>(value: T_1, metatable: LuaMetatable<NoInfer<T_1>> | nil) => T_1
>{ get = function() return value end } : { get: () => T; }
>get : () => T
>function() return value end : () => T
>value : T
>{        __index = function(_, key: "value"): T return value end,        __newindex = function(_, key: "value", next: T) value = next end,    } : { __index: (_: { get: () => T; }, key: "value") => T; __newindex: (_: { get: () => T; }, key: "value", next: T) => void; }

        __index = function(_, key: "value"): T return value end,
>__index : (_: { get: () => T; }, key: "value") => T
>function(_, key: "value"): T return value end : (_: { get: () => T; }, key: "value") => T
>_ : { get: () => T; }
>key : "value"
>value : T

        __newindex = function(_, key: "value", next: T) value = next end,
>__newindex : (_: { get: () => T; }, key: "value", next: T) => void
>function(_, key: "value", next: T) value = next end : (_: { get: () => T; }, key: "value", next: T) => void
>_ : { get: () => T; }
>key : "value"
>next : T
>value = next : T
>value : T
>next : T

    })
end
local ref = createState(1)
>ref : StateRef<number>
>createState(1) : StateRef<number>
>createState : <T>(initial: T) => StateRef<T>
>1 : 1

local v: number = ref.value
