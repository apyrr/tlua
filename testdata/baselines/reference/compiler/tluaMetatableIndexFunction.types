// Overloads that answer the same key both apply: a read of such a key gets whichever one Lua
// dispatches to. Distinct literal keys stay distinct members.
declare overloaded: { __index: { (t: table, k: "a"): number; (t: table, k: "a"): string; (t: table, k: "b"): boolean } };
>overloaded : { __index: { (t: table, k: "a"): number; (t: table, k: "a"): string; (t: table, k: "b"): boolean; }; }
>__index : { (t: table, k: "a"): number; (t: table, k: "a"): string; (t: table, k: "b"): boolean; }
>t : table
>k : "a"
>t : table
>k : "a"
>t : table
>k : "b"

local ov = setmetatable({ n = 1 }, overloaded);
>ov : { n: number; a: string | number; b: boolean; }
>setmetatable({ n = 1 }, overloaded) : { n: number; a: string | number; b: boolean; }
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<NoInfer<T>> | nil) => T
>{ n = 1 } : { n: number; }
>n : number
>1 : 1
>overloaded : { __index: { (t: table, k: "a"): number; (t: table, k: "a"): string; (t: table, k: "b"): boolean; }; }

local either: number | string = ov.a;
>either : string | number
