>"no" : "no"

// A mapped proxy whose members a literal-keyed handler produces needs no assertion either.
type Proxy = { [K in "x" | "y"]: (self: Proxy) => K }
>Proxy : Proxy
>self : Proxy

declare build: (key: string) => any
>build : (key: string) => any
>key : string

local proxy: Proxy = setmetatable({}, { __index = function(_, key: "x" | "y") return build(key) end })
>proxy : Proxy
>setmetatable({}, { __index = function(_, key: "x" | "y") return build(key) end }) : { x: any; y: any; }
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<NoInfer<T>> | nil) => T
>{} : {}
>{ __index = function(_, key: "x" | "y") return build(key) end } : { __index: (_: {}, key: "x" | "y") => any; }
>__index : (_: {}, key: "x" | "y") => any
>function(_, key: "x" | "y") return build(key) end : (_: {}, key: "x" | "y") => any
>_ : {}
>key : "x" | "y"
>build(key) : any
>build : (key: string) => any
>key : "x" | "y"

// A handler generic in its key is a mapped type spelled as a function: each key of the
// constraint is answered with the return type instantiated at that key.
interface Client<P extends string> { ping(self: Client<P>): P; pong(self: Client<P>): number }
>ping : (self: Client<P>) => P
>self : Client<P>
>pong : (self: Client<P>) => number
>self : Client<P>

declare callerFor: <K extends string>(name: K) => any
>callerFor : <K extends string>(name: K) => any
>name : K

function connect<P extends string>(prefix: P): Client<P>
>connect : <P extends string>(prefix: P) => Client<P>
>prefix : P

    return setmetatable({}, {
>setmetatable({}, {        __index = function<K extends keyof Client<P>>(_: table, key: K): Client<P>[K]            return callerFor(key)        end,    }) : { ping: (self: Client<P>) => P; pong: (self: Client<P>) => number; }
>setmetatable : <T extends table>(value: T, metatable: LuaMetatable<NoInfer<T>> | nil) => T
>{} : {}
>{        __index = function<K extends keyof Client<P>>(_: table, key: K): Client<P>[K]            return callerFor(key)        end,    } : { __index: <K extends keyof Client<P>>(_: table, key: K) => Client<P>[K]; }

        __index = function<K extends keyof Client<P>>(_: table, key: K): Client<P>[K]
>__index : <K extends keyof Client<P>>(_: table, key: K) => Client<P>[K]
>function<K extends keyof Client<P>>(_: table, key: K): Client<P>[K]            return callerFor(key)        end : <K extends keyof Client<P>>(_: table, key: K) => Client<P>[K]
>_ : table
>key : K

            return callerFor(key)
>callerFor(key) : any
>callerFor : <K_1 extends string>(name: K_1) => any
>key : K

        end,
    })
end
