    Stop(self: Greeter): nil;
>Stop : Symbol(Greeter.Stop, Decl(tluaLuaContractMembers.tlua, 8, 35))
>self : Symbol(self, Decl(tluaLuaContractMembers.tlua, 9, 9))
>Greeter : Symbol(Greeter, Decl(tluaLuaContractMembers.tlua, 0, 0))
}

