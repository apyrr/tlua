-- A table asserted before its methods are attached converts as built: the
-- attached members complete it, and stand as the contract's own members.
interface Tx {
>Tx : Symbol(Tx, Decl(tluaLuaContractMembers.tlua, 61, 38))

    undo: (() => nil)[];
>undo : Symbol(Tx.undo, Decl(tluaLuaContractMembers.tlua, 65, 14))

    open: boolean;
>open : Symbol(Tx.open, Decl(tluaLuaContractMembers.tlua, 66, 24))

    commit: (self: Tx) => nil;
>commit : Symbol(Tx.commit, Decl(tluaLuaContractMembers.tlua, 67, 18))
>self : Symbol(self, Decl(tluaLuaContractMembers.tlua, 68, 13))
>Tx : Symbol(Tx, Decl(tluaLuaContractMembers.tlua, 61, 38))
}
local tx = { undo = {}, open = true } as Tx
>tx : Symbol(tx, Decl(tluaLuaContractMembers.tlua, 70, 5))
>undo : Symbol(undo, Decl(tluaLuaContractMembers.tlua, 70, 12))
>open : Symbol(open, Decl(tluaLuaContractMembers.tlua, 70, 23))
>Tx : Symbol(Tx, Decl(tluaLuaContractMembers.tlua, 61, 38))

function tx:commit()
>tx : Symbol(tx, Decl(tluaLuaContractMembers.tlua, 70, 5))
>commit : Symbol(commit, Decl(tluaLuaContractMembers.tlua, 70, 43))

    self.open = false
>self.open : Symbol(Tx.open, Decl(tluaLuaContractMembers.tlua, 66, 24))
>self : Symbol(:, Decl(tluaLuaContractMembers.tlua, 71, 11))
>open : Symbol(Tx.open, Decl(tluaLuaContractMembers.tlua, 66, 24))

end

