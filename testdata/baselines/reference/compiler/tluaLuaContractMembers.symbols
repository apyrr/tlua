>self : Symbol(self, Decl(tluaLuaContractMembers.tlua, 7, 12))
>Greeter : Symbol(Greeter, Decl(tluaLuaContractMembers.tlua, 0, 0))

    Gen<T>(self: Greeter, x: T): T;
