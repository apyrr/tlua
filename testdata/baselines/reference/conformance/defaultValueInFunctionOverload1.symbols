=== defaultValueInFunctionOverload1.tlua ===
-- ported from tests/cases/compiler/defaultValueInFunctionOverload1.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- dropped: emit coverage (noEmit) — tlua prints parameter initializers verbatim
--   into the Lua parameter list (`function foo(x = '')`), which is not valid
--   Lua; default-parameter lowering is an open emitter gap
-- note: a bodiless overload signature must be terminated by `;` in tlua, since
--   `end` is what otherwise closes a function body


function foo(x: string = '');
>foo : Symbol(foo, Decl(defaultValueInFunctionOverload1.tlua, 0, 0), Decl(defaultValueInFunctionOverload1.tlua, 9, 29))
>x : Symbol(x, Decl(defaultValueInFunctionOverload1.tlua, 9, 13))

function foo(x = '')
>foo : Symbol(foo, Decl(defaultValueInFunctionOverload1.tlua, 0, 0), Decl(defaultValueInFunctionOverload1.tlua, 9, 29))
>x : Symbol(x, Decl(defaultValueInFunctionOverload1.tlua, 10, 13))

end

