local overloadB = overloaded1(function() return "hi" end, function() return true end)
>overloadB : ["hi", true]
>overloaded1(function() return "hi" end, function() return true end) : ["hi", true]
>overloaded1 : { <const T>(cb: () => T): T; <const T, const U>(cb: () => T, cb2: () => U): [T, U]; }
>function() return "hi" end : () => "hi"
>"hi" : "hi"
>function() return true end : () => true
>true : true

