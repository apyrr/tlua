//// [tests/cases/conformance/ported/implicitAnyDeclareFunctionWithoutFormalType.tlua] ////

=== implicitAnyDeclareFunctionWithoutFormalType.tlua ===
-- ported from tests/cases/compiler/implicitAnyDeclareFunctionWithoutFormalType.ts
-- dropped: @target: es2015 and @noImplicitAny: true directives (tlua defaults to latest target and strict checking)
-- dropped: named rest parameter `...args`; rewritten as tlua's unnamed vararg `...`, which has no
--   name for a diagnostic to point at, so upstream's implicit-any error on `args` has no tlua analogue
-- dropped: emit coverage (noEmit) — tlua parses default parameter values but does not lower them,
--   so func4/noError1 would emit invalid Lua
-- note: upstream's blanket "these should be errors" heading is stale. The upstream baseline reports
--   no diagnostic for the null/undefined-defaulted parameters either, and tlua likewise reports none
--   once they are normalized to nil.


-- these are implicit-any errors
function foo(x)
>foo : Symbol(foo, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 0, 0))
>x : Symbol(x, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 12, 13))

end

function bar(x: number, y)
>bar : Symbol(bar, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 13, 3))
>x : Symbol(x, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 15, 13))
>y : Symbol(y, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 15, 23))

end -- error at "y"; no error at "x"

function func2(a, b, c)
>func2 : Symbol(func2, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 16, 3))
>a : Symbol(a, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 18, 15))
>b : Symbol(b, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 18, 17))
>c : Symbol(c, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 18, 20))

end -- error at "a,b,c"

-- these are not errors
function func3(...)
>func3 : Symbol(func3, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 19, 3))
> : Symbol((Missing), Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 22, 15))

end

function func4(z = nil, w = nil)
>func4 : Symbol(func4, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 23, 3))
>z : Symbol(z, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 25, 15))
>w : Symbol(w, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 25, 23))

end

function noError1(x = 3, y = 2)
>noError1 : Symbol(noError1, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 26, 3))
>x : Symbol(x, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 28, 18))
>y : Symbol(y, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 28, 24))

end

function noError2(x: number, y: string)
>noError2 : Symbol(noError2, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 29, 3))
>x : Symbol(x, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 31, 18))
>y : Symbol(y, Decl(implicitAnyDeclareFunctionWithoutFormalType.tlua, 31, 28))

end

