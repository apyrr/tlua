//// [tests/cases/conformance/ported/mergedInterfacesWithIndexers2.tlua] ////

=== mergedInterfacesWithIndexers2.tlua ===
-- ported from tests/cases/conformance/interfaces/declarationMerging/mergedInterfacesWithIndexers2.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)

-- indexers should behave like other members when merging interface declarations

-- note: upstream reports an incompatibility between merged A's number and string index signatures
--   because JavaScript coerces numeric keys to strings. tlua number and string keys are distinct
--   domains, so the two A signatures are independent and correctly produce no diagnostic; only the
--   A2 property-versus-indexer checks below are errors.

interface A {
>A : Symbol(A, Decl(mergedInterfacesWithIndexers2.tlua, 0, 0), Decl(mergedInterfacesWithIndexers2.tlua, 12, 1))

    [x: number]: string;
>x : Symbol(x, Decl(mergedInterfacesWithIndexers2.tlua, 11, 5))
}

interface A {
>A : Symbol(A, Decl(mergedInterfacesWithIndexers2.tlua, 0, 0), Decl(mergedInterfacesWithIndexers2.tlua, 12, 1))

    [x: string]: { length: string };
>x : Symbol(x, Decl(mergedInterfacesWithIndexers2.tlua, 15, 5))
>length : Symbol(length, Decl(mergedInterfacesWithIndexers2.tlua, 15, 18))
}

interface A2 {
>A2 : Symbol(A2, Decl(mergedInterfacesWithIndexers2.tlua, 16, 1), Decl(mergedInterfacesWithIndexers2.tlua, 21, 1))

    [x: number]: string;
>x : Symbol(x, Decl(mergedInterfacesWithIndexers2.tlua, 19, 5))

    "a": number; -- error
>"a" : Symbol(A2["a"], Decl(mergedInterfacesWithIndexers2.tlua, 19, 24))
}

interface A2 {
>A2 : Symbol(A2, Decl(mergedInterfacesWithIndexers2.tlua, 16, 1), Decl(mergedInterfacesWithIndexers2.tlua, 21, 1))

    [x: string]: { length: number };
>x : Symbol(x, Decl(mergedInterfacesWithIndexers2.tlua, 24, 5))
>length : Symbol(length, Decl(mergedInterfacesWithIndexers2.tlua, 24, 18))

    1: { length: number }; -- error
>1 : Symbol(A2[1], Decl(mergedInterfacesWithIndexers2.tlua, 24, 36))
>length : Symbol(length, Decl(mergedInterfacesWithIndexers2.tlua, 25, 8))
}

