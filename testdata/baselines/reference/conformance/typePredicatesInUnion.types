>x : {}
}

type Or = A | B
>Or : Or

function f(o: Or, x: {})
>f : (o: Or, x: {}) => void
>o : Or
>x : {}

    if o.pred(x) then
>o.pred(x) : boolean
>o.pred : ((x: {}) => x is boolean) | ((x: {}) => x is string)
>o : Or
>pred : ((x: {}) => x is boolean) | ((x: {}) => x is string)
>x : {}

        local narrowed = x
>narrowed : string | boolean
