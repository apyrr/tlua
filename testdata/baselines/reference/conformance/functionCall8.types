=== functionCall8.tlua ===
-- ported from tests/cases/compiler/functionCall8.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)

function foo(a?: string)
>foo : (a?: string) => void
>a : string | nil

end

foo('foo')
>foo('foo') : void
>foo : (a?: string) => void
>'foo' : "foo"

foo('foo', 'bar')
>foo('foo', 'bar') : void
>foo : (a?: string) => void
>'foo' : "foo"
>'bar' : "bar"

foo(4)
>foo(4) : void
>foo : (a?: string) => void
>4 : 4

foo()
>foo() : void
>foo : (a?: string) => void

