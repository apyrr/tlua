-- trailing comment instead


declare function f(): void;
>f : Symbol(f, Decl(commentOnExpressionStatement1.tlua, 0, 0))

f() -- Comment.
>f : Symbol(f, Decl(commentOnExpressionStatement1.tlua, 0, 0))

