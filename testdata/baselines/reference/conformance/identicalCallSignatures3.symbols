    (x: number): string
>x : Symbol(x, Decl(identicalCallSignatures3.tlua, 12, 5))
}

interface I2<T> {
>I2 : Symbol(I2, Decl(identicalCallSignatures3.tlua, 13, 1), Decl(identicalCallSignatures3.tlua, 17, 1))
>T : Symbol(T, Decl(identicalCallSignatures3.tlua, 15, 13), Decl(identicalCallSignatures3.tlua, 19, 13))

    (x: number): string
>x : Symbol(x, Decl(identicalCallSignatures3.tlua, 16, 5))
}

interface I2<T> {
