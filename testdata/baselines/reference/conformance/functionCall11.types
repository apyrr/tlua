=== functionCall11.tlua ===
-- ported from tests/cases/compiler/functionCall11.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)

function foo(a: string, b?: number)
>foo : (a: string, b?: number) => void
>a : string
>b : number | nil

end

foo('foo', 1)
>foo('foo', 1) : void
>foo : (a: string, b?: number) => void
>'foo' : "foo"
>1 : 1

foo('foo')
>foo('foo') : void
>foo : (a: string, b?: number) => void
>'foo' : "foo"

foo()
>foo() : void
>foo : (a: string, b?: number) => void

foo(1, 'bar')
>foo(1, 'bar') : void
>foo : (a: string, b?: number) => void
>1 : 1
>'bar' : "bar"

foo('foo', 1, 'bar')
>foo('foo', 1, 'bar') : void
>foo : (a: string, b?: number) => void
>'foo' : "foo"
>1 : 1
>'bar' : "bar"

