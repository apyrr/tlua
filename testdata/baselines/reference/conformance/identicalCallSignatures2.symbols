-- Normally it is an error to have multiple overloads with identical signatures in a single type declaration.
-- Here the multiple overloads come from multiple bases.

interface Base<T> {
>Base : Symbol(Base, Decl(identicalCallSignatures2.tlua, 0, 0))
>T : Symbol(T, Decl(identicalCallSignatures2.tlua, 7, 15))

    (x: number): string
>x : Symbol(x, Decl(identicalCallSignatures2.tlua, 8, 5))
}

interface I extends Base<string>, Base<number> {}
>I : Symbol(I, Decl(identicalCallSignatures2.tlua, 9, 1))
>Base : Symbol(Base, Decl(identicalCallSignatures2.tlua, 0, 0))
>Base : Symbol(Base, Decl(identicalCallSignatures2.tlua, 0, 0))

interface I2<T> extends Base<string>, Base<number> {}
>I2 : Symbol(I2, Decl(identicalCallSignatures2.tlua, 11, 49))
>T : Symbol(T, Decl(identicalCallSignatures2.tlua, 13, 13))
>Base : Symbol(Base, Decl(identicalCallSignatures2.tlua, 0, 0))
>Base : Symbol(Base, Decl(identicalCallSignatures2.tlua, 0, 0))

