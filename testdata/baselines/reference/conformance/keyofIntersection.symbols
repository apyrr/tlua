//// [tests/cases/conformance/ported/keyofIntersection.tlua] ////

=== keyofIntersection.tlua ===
-- ported from tests/cases/conformance/types/keyof/keyofIntersection.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- dropped: @strict: true directive (tlua keeps strict checking enabled)
-- dropped: @declaration: true -- tlua has declaration-emit machinery, but it reports
--   TLUA100054 for every .tlua source, so restoring the directive would replace this test's
--   subject with that one diagnostic. tluaModuleDeclarationEmitUnsupported.tlua covers it.


type A = { a: string }
>A : Symbol(A, Decl(keyofIntersection.tlua, 0, 0))
>a : Symbol(a, Decl(keyofIntersection.tlua, 8, 10))

type B = { b: string }
>B : Symbol(B, Decl(keyofIntersection.tlua, 8, 22))
>b : Symbol(b, Decl(keyofIntersection.tlua, 9, 10))

type T01 = keyof (A & B) -- "a" | "b"
>T01 : Symbol(T01, Decl(keyofIntersection.tlua, 9, 22))
>A : Symbol(A, Decl(keyofIntersection.tlua, 0, 0))
>B : Symbol(B, Decl(keyofIntersection.tlua, 8, 22))

type T02<T> = keyof (T & B) -- "b" | keyof T
>T02 : Symbol(T02, Decl(keyofIntersection.tlua, 11, 24))
>T : Symbol(T, Decl(keyofIntersection.tlua, 12, 9))
>T : Symbol(T, Decl(keyofIntersection.tlua, 12, 9))
>B : Symbol(B, Decl(keyofIntersection.tlua, 8, 22))

type T03<U> = keyof (A & U) -- "a" | keyof U
>T03 : Symbol(T03, Decl(keyofIntersection.tlua, 12, 27))
>U : Symbol(U, Decl(keyofIntersection.tlua, 13, 9))
>A : Symbol(A, Decl(keyofIntersection.tlua, 0, 0))
>U : Symbol(U, Decl(keyofIntersection.tlua, 13, 9))

type T04<T, U> = keyof (T & U) -- keyof T | keyof U
>T04 : Symbol(T04, Decl(keyofIntersection.tlua, 13, 27))
>T : Symbol(T, Decl(keyofIntersection.tlua, 14, 9))
>U : Symbol(U, Decl(keyofIntersection.tlua, 14, 11))
>T : Symbol(T, Decl(keyofIntersection.tlua, 14, 9))
>U : Symbol(U, Decl(keyofIntersection.tlua, 14, 11))

type T05 = T02<A> -- "a" | "b"
>T05 : Symbol(T05, Decl(keyofIntersection.tlua, 14, 30))
>T02 : Symbol(T02, Decl(keyofIntersection.tlua, 11, 24))
>A : Symbol(A, Decl(keyofIntersection.tlua, 0, 0))

type T06 = T03<B> -- "a" | "b"
>T06 : Symbol(T06, Decl(keyofIntersection.tlua, 15, 17))
>T03 : Symbol(T03, Decl(keyofIntersection.tlua, 12, 27))
>B : Symbol(B, Decl(keyofIntersection.tlua, 8, 22))

type T07 = T04<A, B> -- "a" | "b"
>T07 : Symbol(T07, Decl(keyofIntersection.tlua, 16, 17))
>T04 : Symbol(T04, Decl(keyofIntersection.tlua, 13, 27))
>A : Symbol(A, Decl(keyofIntersection.tlua, 0, 0))
>B : Symbol(B, Decl(keyofIntersection.tlua, 8, 22))

-- Repros from #22291

type Example1<T extends string, U extends string> = keyof (Record<T, any> & Record<U, any>)
>Example1 : Symbol(Example1, Decl(keyofIntersection.tlua, 17, 20))
>T : Symbol(T, Decl(keyofIntersection.tlua, 21, 14))
>U : Symbol(U, Decl(keyofIntersection.tlua, 21, 31))
