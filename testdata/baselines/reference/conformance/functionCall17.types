//// [tests/cases/conformance/ported/functionCall17.tlua] ////

=== functionCall17.tlua ===
-- ported from tests/cases/compiler/functionCall17.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- dropped: named rest parameter `...d` and its array annotation; rewritten as tlua's unnamed scalar vararg `...: number`

function foo(a: string, b?: string, c?: number, ...: number)
>foo : (a: string, b?: string, c?: number, ...: number) => void
>a : string
>b : string | nil
>c : number | nil
> : number[]

end

foo("foo", 1)
>foo("foo", 1) : void
>foo : (a: string, b?: string, c?: number, ...: number) => void
>"foo" : "foo"
>1 : 1

foo("foo")
>foo("foo") : void
>foo : (a: string, b?: string, c?: number, ...: number) => void
>"foo" : "foo"

foo()
>foo() : void
>foo : (a: string, b?: string, c?: number, ...: number) => void

foo(1, "bar")
>foo(1, "bar") : void
>foo : (a: string, b?: string, c?: number, ...: number) => void
>1 : 1
>"bar" : "bar"

foo("foo", 1, 3)
>foo("foo", 1, 3) : void
>foo : (a: string, b?: string, c?: number, ...: number) => void
>"foo" : "foo"
>1 : 1
>3 : 3

foo("foo", "bar", 3, 4)
>foo("foo", "bar", 3, 4) : void
>foo : (a: string, b?: string, c?: number, ...: number) => void
>"foo" : "foo"
>"bar" : "bar"
>3 : 3
>4 : 4

