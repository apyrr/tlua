=== specializationError.tlua ===
-- ported from tests/cases/compiler/specializationError.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- dropped: Promise return type renamed to Result because Promise is not part of tlua's library surface

interface Result<T> {
    then<U>(value: T): void
>then : <U>(value: T) => void
>value : T
}

interface Bar {
    bar(value: "Menu"): Result<string>
>bar : { (value: "Menu"): Result<string>; <T>(value: string, element: string): Result<T>; <T>(value: string): Result<T>; }
>value : "Menu"

    bar<T>(value: string, element: string): Result<T>
>bar : { (value: "Menu"): Result<string>; <T>(value: string, element: string): Result<T>; <T_1>(value: string): Result<T_1>; }
>value : string
>element : string

    bar<T>(value: string): Result<T>
>bar : { (value: "Menu"): Result<string>; <T_1>(value: string, element: string): Result<T_1>; <T>(value: string): Result<T>; }
>value : string
}

