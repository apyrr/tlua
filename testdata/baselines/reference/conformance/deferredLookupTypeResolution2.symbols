//// [tests/cases/conformance/ported/deferredLookupTypeResolution2.tlua] ////

=== deferredLookupTypeResolution2.tlua ===
-- ported from tests/cases/compiler/deferredLookupTypeResolution2.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- note: tlua sequences are 1-based, so every upstream tuple position key is
--   shifted by one here: '0'->'1', '1'->'2', '2'->'3'.
-- note: a Lua number key is not a string key. A tuple's element keys are number
--   keys, so `Extract<keyof T, string>` on a tuple contains none of them and
--   `ObjectHasKey<tuple, ...>` resolves to 'false' at every position. That is
--   the intended tlua key mapping, not a checker gap; upstream's "true" results
--   for B and D therefore read 'false' here.
-- dropped: @declaration: true -- tlua has declaration-emit machinery, but it reports
--   TLUA100054 for every .tlua source, so restoring the directive would replace this test's
--   subject with that one diagnostic. tluaModuleDeclarationEmitUnsupported.tlua covers it.


-- Repro from #17456

type StringContains<S extends string, L extends string> = ({ [K in S]: 'true' } & { [key: string]: 'false' })[L]
>StringContains : Symbol(StringContains, Decl(deferredLookupTypeResolution2.tlua, 0, 0))
>S : Symbol(S, Decl(deferredLookupTypeResolution2.tlua, 16, 20))
>L : Symbol(L, Decl(deferredLookupTypeResolution2.tlua, 16, 37))
>K : Symbol(K, Decl(deferredLookupTypeResolution2.tlua, 16, 62))
>S : Symbol(S, Decl(deferredLookupTypeResolution2.tlua, 16, 20))
>key : Symbol(key, Decl(deferredLookupTypeResolution2.tlua, 16, 85))
>L : Symbol(L, Decl(deferredLookupTypeResolution2.tlua, 16, 37))

type ObjectHasKey<O, L extends string> = StringContains<Extract<keyof O, string>, L>
>ObjectHasKey : Symbol(ObjectHasKey, Decl(deferredLookupTypeResolution2.tlua, 16, 112))
>O : Symbol(O, Decl(deferredLookupTypeResolution2.tlua, 18, 18))
>L : Symbol(L, Decl(deferredLookupTypeResolution2.tlua, 18, 20))
>StringContains : Symbol(StringContains, Decl(deferredLookupTypeResolution2.tlua, 0, 0))
>Extract : Symbol(Extract, Decl(lib.luajit.d.tlua, --, --))
>O : Symbol(O, Decl(deferredLookupTypeResolution2.tlua, 18, 18))
>L : Symbol(L, Decl(deferredLookupTypeResolution2.tlua, 18, 20))

type A<T> = ObjectHasKey<T, '1'>
>A : Symbol(A, Decl(deferredLookupTypeResolution2.tlua, 18, 84))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 20, 7))
>ObjectHasKey : Symbol(ObjectHasKey, Decl(deferredLookupTypeResolution2.tlua, 16, 112))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 20, 7))

type B = ObjectHasKey<[string, number], '2'> -- upstream "true"; 'false' in tlua (number key)
>B : Symbol(B, Decl(deferredLookupTypeResolution2.tlua, 20, 32))
>ObjectHasKey : Symbol(ObjectHasKey, Decl(deferredLookupTypeResolution2.tlua, 16, 112))

type C = ObjectHasKey<[string, number], '3'> -- "false" (out of range)
>C : Symbol(C, Decl(deferredLookupTypeResolution2.tlua, 22, 44))
>ObjectHasKey : Symbol(ObjectHasKey, Decl(deferredLookupTypeResolution2.tlua, 16, 112))

type D = A<[string]> -- upstream "true"; 'false' in tlua (number key)
>D : Symbol(D, Decl(deferredLookupTypeResolution2.tlua, 23, 44))
>A : Symbol(A, Decl(deferredLookupTypeResolution2.tlua, 18, 84))

-- Error, "false" not handled
type E<T> = { true: 'true' }[ObjectHasKey<T, '2'>]
>E : Symbol(E, Decl(deferredLookupTypeResolution2.tlua, 24, 20))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 27, 7))
>true : Symbol(true, Decl(deferredLookupTypeResolution2.tlua, 27, 13))
>ObjectHasKey : Symbol(ObjectHasKey, Decl(deferredLookupTypeResolution2.tlua, 16, 112))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 27, 7))

type Juxtapose<T> = ({ true: 'otherwise' } & { [k: string]: 'true' })[ObjectHasKey<T, '2'>]
>Juxtapose : Symbol(Juxtapose, Decl(deferredLookupTypeResolution2.tlua, 27, 50))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 29, 15))
>true : Symbol(true, Decl(deferredLookupTypeResolution2.tlua, 29, 22))
>k : Symbol(k, Decl(deferredLookupTypeResolution2.tlua, 29, 48))
>ObjectHasKey : Symbol(ObjectHasKey, Decl(deferredLookupTypeResolution2.tlua, 16, 112))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 29, 15))

-- Error, "otherwise" is missing
type DeepError<T> = { true: 'true' }[Juxtapose<T>]
>DeepError : Symbol(DeepError, Decl(deferredLookupTypeResolution2.tlua, 29, 91))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 32, 15))
>true : Symbol(true, Decl(deferredLookupTypeResolution2.tlua, 32, 21))
>Juxtapose : Symbol(Juxtapose, Decl(deferredLookupTypeResolution2.tlua, 27, 50))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 32, 15))

type DeepOK<T> = { true: 'true', otherwise: 'false' }[Juxtapose<T>]
>DeepOK : Symbol(DeepOK, Decl(deferredLookupTypeResolution2.tlua, 32, 50))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 34, 12))
>true : Symbol(true, Decl(deferredLookupTypeResolution2.tlua, 34, 18))
>otherwise : Symbol(otherwise, Decl(deferredLookupTypeResolution2.tlua, 34, 32))
>Juxtapose : Symbol(Juxtapose, Decl(deferredLookupTypeResolution2.tlua, 27, 50))
>T : Symbol(T, Decl(deferredLookupTypeResolution2.tlua, 34, 12))

