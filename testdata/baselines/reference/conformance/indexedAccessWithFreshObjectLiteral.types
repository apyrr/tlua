//// [tests/cases/conformance/ported/indexedAccessWithFreshObjectLiteral.tlua] ////

=== indexedAccessWithFreshObjectLiteral.tlua ===
-- ported from tests/cases/compiler/indexedAccessWithFreshObjectLiteral.ts
-- dropped: @target: es2015 and @strict directives (tlua uses the latest target and strict checking by default)
-- note: tlua enables noUncheckedIndexedAccess by default, so index reads add `| nil` on their own.
--   Upstream runs with that option off, so its corge/grault results are `string | number` while
--   tlua's are `string | number | nil`.
-- note: upstream's numeric-looking keys (`1:`, `2:`) are string keys in JavaScript. tlua number and
--   string keys are distinct domains, so baz keeps them as string keys `["1"]` and qux covers the
--   number-key domain separately with `[1]`.

function foo(id: string)
>foo : (id: string) => string | number | boolean | nil
>id : string

    return ({
>({        a = 1,        b = "",        c = true    })[id] : string | number | boolean | nil
>({        a = 1,        b = "",        c = true    }) : { a: number; b: string; c: boolean; }
>{        a = 1,        b = "",        c = true    } : { a: number; b: string; c: boolean; }

        a = 1,
>a : number
>1 : 1

        b = "",
>b : string
>"" : ""

        c = true
>c : boolean
>true : true

    })[id]
>id : string

end

function bar(id: 'a' | 'b')
>bar : (id: 'a' | 'b') => string | number
>id : "a" | "b"

    return ({
>({        a = 1,        b = "",        c = false    })[id] : string | number
>({        a = 1,        b = "",        c = false    }) : { a: number; b: string; c: boolean; }
>{        a = 1,        b = "",        c = false    } : { a: number; b: string; c: boolean; }

        a = 1,
>a : number
>1 : 1

        b = "",
>b : string
>"" : ""

        c = false
>c : boolean
>false : false

    })[id]
>id : "a" | "b"

end

function baz(id: '1' | '2')
>baz : (id: '1' | '2') => string | number
>id : "1" | "2"

    return ({
>({        ["1"] = 1,        ["2"] = "",        ["3"] = false    })[id] : string | number
>({        ["1"] = 1,        ["2"] = "",        ["3"] = false    }) : { "1": number; "2": string; "3": boolean; }
>{        ["1"] = 1,        ["2"] = "",        ["3"] = false    } : { "1": number; "2": string; "3": boolean; }

        ["1"] = 1,
>["1"] : number
>"1" : "1"
>1 : 1

        ["2"] = "",
>["2"] : string
>"2" : "2"
>"" : ""

        ["3"] = false
>["3"] : boolean
>"3" : "3"
>false : false

    })[id]
>id : "1" | "2"

end

function qux(id: 1 | 2)
>qux : (id: 1 | 2) => string | number
>id : 1 | 2

    return ({
>({        [1] = 1,        [2] = "",        [3] = false    })[id] : string | number
>({        [1] = 1,        [2] = "",        [3] = false    }) : { 1: number; 2: string; 3: boolean; }
>{        [1] = 1,        [2] = "",        [3] = false    } : { 1: number; 2: string; 3: boolean; }

        [1] = 1,
>[1] : number
>1 : 1
>1 : 1

        [2] = "",
>[2] : string
>2 : 2
>"" : ""

        [3] = false
>[3] : boolean
>3 : 3
>false : false

    })[id]
>id : 1 | 2

end

function quux(id: 'a' | 'b' | 'z')
>quux : (id: 'a' | 'b' | 'z') => string | number | nil
>id : "a" | "b" | "z"

    return ({
>({        a = 1,        b = "",        c = false    })[id] : string | number | nil
>({        a = 1,        b = "",        c = false    }) : { a: number; b: string; c: boolean; }
>{        a = 1,        b = "",        c = false    } : { a: number; b: string; c: boolean; }

        a = 1,
>a : number
>1 : 1

        b = "",
>b : string
>"" : ""

        c = false
>c : boolean
>false : false

    })[id]
>id : "a" | "b" | "z"

end

function corge(id: string)
>corge : (id: string) => string | number | nil
>id : string

    return (({
>(({        a = 123,        b = ""    }) as Record<string, number | string>)[id] : string | number | nil
>(({        a = 123,        b = ""    }) as Record<string, number | string>) : Record<string, string | number>
>({        a = 123,        b = ""    }) as Record<string, number | string> : Record<string, string | number>
>({        a = 123,        b = ""    }) : { a: number; b: string; }
>{        a = 123,        b = ""    } : { a: number; b: string; }

        a = 123,
>a : number
>123 : 123

        b = ""
>b : string
>"" : ""

    }) as Record<string, number | string>)[id]
>id : string

end

function grault(id: string)
>grault : (id: string) => string | number | nil
>id : string

    return (({
>(({        a = 123,        b = ""    }) as { [k: string]: string | number })[id] : string | number | nil
>(({        a = 123,        b = ""    }) as { [k: string]: string | number }) : { [k: string]: string | number; }
>({        a = 123,        b = ""    }) as { [k: string]: string | number } : { [k: string]: string | number; }
>({        a = 123,        b = ""    }) : { a: number; b: string; }
>{        a = 123,        b = ""    } : { a: number; b: string; }

        a = 123,
>a : number
>123 : 123

        b = ""
>b : string
>"" : ""

    }) as { [k: string]: string | number })[id]
>k : string
>id : string

end

