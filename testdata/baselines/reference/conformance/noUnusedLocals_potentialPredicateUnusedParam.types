function potentialPredicateUnusedParam(a: unknown)
>potentialPredicateUnusedParam : (a: unknown) => boolean
>a : unknown

    return not not math.random()
>not not math.random() : true
>not math.random() : false
>math.random() : number
>math.random : { (): number; (upper: number): number; (lower: number, upper: number): number; }
