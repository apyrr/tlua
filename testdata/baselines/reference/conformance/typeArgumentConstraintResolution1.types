//// [tests/cases/conformance/ported/typeArgumentConstraintResolution1.tlua] ////

=== typeArgumentConstraintResolution1.tlua ===
-- ported from tests/cases/compiler/typeArgumentConstraintResolution1.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- dropped: JavaScript Date/Number/String wrapper constraints, replaced with local structural constraint interfaces


interface DateConstraint {
    date: string
>date : string
}

interface NumberConstraint {
    number: number
>number : number
}

interface StringConstraint {
    string: string
>string : string
}

function foo1<T extends DateConstraint>(test: T);
>foo1 : { <T extends DateConstraint>(test: T): any; <T_1 extends NumberConstraint>(test: string): any; }
>test : T

function foo1<T extends NumberConstraint>(test: string);
>foo1 : { <T_1 extends DateConstraint>(test: T_1): any; <T extends NumberConstraint>(test: string): any; }
>test : string

function foo1<T extends StringConstraint>(test: any) end
>foo1 : { <T_1 extends DateConstraint>(test: T_1): any; <T_1 extends NumberConstraint>(test: string): any; }
>test : any

foo1<DateConstraint>("") -- should error
>foo1<DateConstraint>("") : any
>foo1 : { <T extends DateConstraint>(test: T): any; <T extends NumberConstraint>(test: string): any; }
>"" : ""

function foo2<T extends DateConstraint>(test: T): T;
>foo2 : { <T extends DateConstraint>(test: T): T; <T_1 extends NumberConstraint>(test: string): T_1; }
>test : T

function foo2<T extends NumberConstraint>(test: string): T;
>foo2 : { <T_1 extends DateConstraint>(test: T_1): T_1; <T extends NumberConstraint>(test: string): T; }
>test : string

function foo2<T extends StringConstraint>(test: any): any
>foo2 : { <T_1 extends DateConstraint>(test: T_1): T_1; <T_1 extends NumberConstraint>(test: string): T_1; }
>test : any

    return nil
end

foo2<DateConstraint>("") -- DateConstraint does not satisfy the constraint NumberConstraint for T
>foo2<DateConstraint>("") : DateConstraint
>foo2 : { <T extends DateConstraint>(test: T): T; <T extends NumberConstraint>(test: string): T; }
>"" : ""

