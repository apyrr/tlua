//// [tests/cases/conformance/ported/functionCall14.tlua] ////

=== functionCall14.tlua ===
-- ported from tests/cases/compiler/functionCall14.ts
-- dropped: @target: es2015 directive (tlua defaults to latest target)
-- dropped: named rest parameter `...b` and its array annotation; rewritten as tlua's unnamed scalar vararg `...: number`

function foo(a?: string, ...: number)
>foo : (a?: string, ...: number) => void
>a : string | nil
> : number[]

end

foo("foo", 1)
>foo("foo", 1) : void
>foo : (a?: string, ...: number) => void
>"foo" : "foo"
>1 : 1

foo("foo")
>foo("foo") : void
>foo : (a?: string, ...: number) => void
>"foo" : "foo"

foo()
>foo() : void
>foo : (a?: string, ...: number) => void

foo(1, "bar")
>foo(1, "bar") : void
>foo : (a?: string, ...: number) => void
>1 : 1
>"bar" : "bar"

foo("foo", 1, 3)
>foo("foo", 1, 3) : void
>foo : (a?: string, ...: number) => void
>"foo" : "foo"
>1 : 1
>3 : 3

