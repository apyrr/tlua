>{  prop = "foo",  nested = {    nestedProp = "bar",  },} : { prop: "foo"; nested: { nestedProp: "bar"; }; }

  prop = "foo",
>prop : "foo"
>"foo" : "foo"

  nested = {
>nested : { nestedProp: "bar"; }
>{    nestedProp = "bar",  } : { nestedProp: "bar"; }

    nestedProp = "bar",
>nestedProp : "bar"
>"bar" : "bar"

  },
})

