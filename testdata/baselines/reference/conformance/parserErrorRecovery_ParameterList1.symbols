-- dropped: emit coverage (noEmit) -- the source is intentionally malformed, so whatever the parser
-- recovers is not meaningful Lua to baseline.

function f(a
>f : Symbol(f, Decl(parserErrorRecovery_ParameterList1.tlua, 0, 0))
>a : Symbol(a, Decl(parserErrorRecovery_ParameterList1.tlua, 7, 11))

end

