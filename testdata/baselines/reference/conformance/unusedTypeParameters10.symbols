-- but tlua additionally reports the top-level alias names Alias and Alias2 as unused


type Alias<T> = {}
>Alias : Symbol(Alias, Decl(unusedTypeParameters10.tlua, 0, 0))
>T : Symbol(T, Decl(unusedTypeParameters10.tlua, 6, 11))

type Alias2<T> = { x: T }
>Alias2 : Symbol(Alias2, Decl(unusedTypeParameters10.tlua, 6, 18))
>T : Symbol(T, Decl(unusedTypeParameters10.tlua, 7, 12))
>x : Symbol(x, Decl(unusedTypeParameters10.tlua, 7, 18))
>T : Symbol(T, Decl(unusedTypeParameters10.tlua, 7, 12))

