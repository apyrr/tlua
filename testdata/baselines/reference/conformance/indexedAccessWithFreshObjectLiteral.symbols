//// [tests/cases/conformance/ported/indexedAccessWithFreshObjectLiteral.tlua] ////

=== indexedAccessWithFreshObjectLiteral.tlua ===
-- ported from tests/cases/compiler/indexedAccessWithFreshObjectLiteral.ts
-- dropped: @target: es2015 and @strict directives (tlua uses the latest target and strict checking by default)
-- note: tlua enables noUncheckedIndexedAccess by default, so index reads add `| nil` on their own.
--   Upstream runs with that option off, so its corge/grault results are `string | number` while
--   tlua's are `string | number | nil`.
-- note: upstream's numeric-looking keys (`1:`, `2:`) are string keys in JavaScript. tlua number and
--   string keys are distinct domains, so baz keeps them as string keys `["1"]` and qux covers the
--   number-key domain separately with `[1]`.

function foo(id: string)
>foo : Symbol(foo, Decl(indexedAccessWithFreshObjectLiteral.tlua, 0, 0))
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 9, 13))

    return ({
        a = 1,
>a : Symbol(a, Decl(indexedAccessWithFreshObjectLiteral.tlua, 10, 13))

        b = "",
>b : Symbol(b, Decl(indexedAccessWithFreshObjectLiteral.tlua, 11, 14))

        c = true
>c : Symbol(c, Decl(indexedAccessWithFreshObjectLiteral.tlua, 12, 15))

    })[id]
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 9, 13))

end

function bar(id: 'a' | 'b')
>bar : Symbol(bar, Decl(indexedAccessWithFreshObjectLiteral.tlua, 15, 3))
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 17, 13))

    return ({
        a = 1,
>a : Symbol(a, Decl(indexedAccessWithFreshObjectLiteral.tlua, 18, 13))

        b = "",
>b : Symbol(b, Decl(indexedAccessWithFreshObjectLiteral.tlua, 19, 14))

        c = false
>c : Symbol(c, Decl(indexedAccessWithFreshObjectLiteral.tlua, 20, 15))

    })[id]
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 17, 13))

end

function baz(id: '1' | '2')
>baz : Symbol(baz, Decl(indexedAccessWithFreshObjectLiteral.tlua, 23, 3))
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 25, 13))

    return ({
        ["1"] = 1,
>["1"] : Symbol(["1"], Decl(indexedAccessWithFreshObjectLiteral.tlua, 26, 13))
>"1" : Symbol(["1"], Decl(indexedAccessWithFreshObjectLiteral.tlua, 26, 13))

        ["2"] = "",
>["2"] : Symbol(["2"], Decl(indexedAccessWithFreshObjectLiteral.tlua, 27, 18))
>"2" : Symbol(["2"], Decl(indexedAccessWithFreshObjectLiteral.tlua, 27, 18))

        ["3"] = false
>["3"] : Symbol(["3"], Decl(indexedAccessWithFreshObjectLiteral.tlua, 28, 19))
>"3" : Symbol(["3"], Decl(indexedAccessWithFreshObjectLiteral.tlua, 28, 19))

    })[id]
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 25, 13))

end

function qux(id: 1 | 2)
>qux : Symbol(qux, Decl(indexedAccessWithFreshObjectLiteral.tlua, 31, 3))
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 33, 13))

    return ({
        [1] = 1,
>[1] : Symbol([1], Decl(indexedAccessWithFreshObjectLiteral.tlua, 34, 13))
>1 : Symbol([1], Decl(indexedAccessWithFreshObjectLiteral.tlua, 34, 13))

        [2] = "",
>[2] : Symbol([2], Decl(indexedAccessWithFreshObjectLiteral.tlua, 35, 16))
>2 : Symbol([2], Decl(indexedAccessWithFreshObjectLiteral.tlua, 35, 16))

        [3] = false
>[3] : Symbol([3], Decl(indexedAccessWithFreshObjectLiteral.tlua, 36, 17))
>3 : Symbol([3], Decl(indexedAccessWithFreshObjectLiteral.tlua, 36, 17))

    })[id]
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 33, 13))

end

