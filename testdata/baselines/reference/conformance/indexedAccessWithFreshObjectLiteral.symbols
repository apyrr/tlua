    })[id]
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 41, 14))

end

function corge(id: string)
>corge : Symbol(corge, Decl(indexedAccessWithFreshObjectLiteral.tlua, 47, 3))
>id : Symbol(id, Decl(indexedAccessWithFreshObjectLiteral.tlua, 49, 15))

    return (({
        a = 123,
>a : Symbol(a, Decl(indexedAccessWithFreshObjectLiteral.tlua, 50, 14))

