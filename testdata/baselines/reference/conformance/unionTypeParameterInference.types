interface Foo<T> { prop: T }
>prop : T

declare lift: <U>(value: U | Foo<U>) => Foo<U>
>lift : <U>(value: U | Foo<U>) => Foo<U>
>value : U | Foo<U>

function unlift<U>(value: U | Foo<U>): U
>unlift : <U>(value: U | Foo<U>) => U
>value : U | Foo<U>

    return lift(value).prop
>lift(value).prop : U
>lift(value) : Foo<U>
>lift : <U_1>(value: U_1 | Foo<U_1>) => Foo<U_1>
>value : U | Foo<U>
>prop : U

end

